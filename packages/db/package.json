{
  "name": "@pipe/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle: schema, migrations e políticas RLS do Pipe",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "gerar": "drizzle-kit generate",
    "gerar:custom": "drizzle-kit generate --custom",
    "migrar": "tsx src/migrar.ts",
    "semear": "tsx src/semente.ts",
    "semear:demo": "tsx src/semente-demo.ts",
    "particoes": "tsx src/scripts/criar-particoes.ts"
  },
  "dependencies": {
    "@pipe/core": "workspace:*",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
