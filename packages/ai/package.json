{
  "name": "@pipe/ai",
  "version": "0.1.0",
  "private": true,
  "description": "Resumo, classificação e avaliação com IA",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./transcription": {
      "types": "./dist/transcription/index.d.ts",
      "default": "./dist/transcription/index.js"
    },
    "./resumo": {
      "types": "./dist/resumo/index.d.ts",
      "default": "./dist/resumo/index.js"
    },
    "./classification": {
      "types": "./dist/classification/index.d.ts",
      "default": "./dist/classification/index.js"
    },
    "./evaluation": {
      "types": "./dist/evaluation/index.d.ts",
      "default": "./dist/evaluation/index.js"
    },
    "./consumo": {
      "types": "./dist/consumo/index.d.ts",
      "default": "./dist/consumo/index.js"
    },
    "./bancada": {
      "types": "./dist/bancada/index.d.ts",
      "default": "./dist/bancada/index.js"
    },
    "./agente": {
      "types": "./dist/agente/index.d.ts",
      "default": "./dist/agente/index.js"
    },
    "./embeddings": {
      "types": "./dist/embeddings/index.d.ts",
      "default": "./dist/embeddings/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
