{
  "name": "@pipe/core",
  "version": "0.1.0",
  "private": true,
  "description": "Regras puras e testáveis do Pipe: métricas, esforço, score, distribuição, SLA, máquina de estados da conversa e janela de 24h",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "default": "./dist/metrics/index.js"
    },
    "./effort": {
      "types": "./dist/effort/index.d.ts",
      "default": "./dist/effort/index.js"
    },
    "./score": {
      "types": "./dist/score/index.d.ts",
      "default": "./dist/score/index.js"
    },
    "./distribution": {
      "types": "./dist/distribution/index.d.ts",
      "default": "./dist/distribution/index.js"
    },
    "./sla": {
      "types": "./dist/sla/index.d.ts",
      "default": "./dist/sla/index.js"
    },
    "./conversation": {
      "types": "./dist/conversation/index.d.ts",
      "default": "./dist/conversation/index.js"
    },
    "./window": {
      "types": "./dist/window/index.d.ts",
      "default": "./dist/window/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "default": "./dist/analytics/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.testes.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
