{
  "name": "@pipe/core",
  "version": "0.1.0",
  "private": true,
  "description": "Regras puras e testáveis do Pipe: métricas, esforço, score, distribuição, SLA, máquina de estados da conversa e janela de 24h",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./metricas": {
      "types": "./dist/metricas/index.d.ts",
      "default": "./dist/metricas/index.js"
    },
    "./esforco": {
      "types": "./dist/esforco/index.d.ts",
      "default": "./dist/esforco/index.js"
    },
    "./score": {
      "types": "./dist/score/index.d.ts",
      "default": "./dist/score/index.js"
    },
    "./distribuicao": {
      "types": "./dist/distribuicao/index.d.ts",
      "default": "./dist/distribuicao/index.js"
    },
    "./sla": {
      "types": "./dist/sla/index.d.ts",
      "default": "./dist/sla/index.js"
    },
    "./conversa": {
      "types": "./dist/conversa/index.d.ts",
      "default": "./dist/conversa/index.js"
    },
    "./janela": {
      "types": "./dist/janela/index.d.ts",
      "default": "./dist/janela/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.testes.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:observar": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
