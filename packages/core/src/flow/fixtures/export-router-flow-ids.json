      "type": "ExecuteScript",
      "settings": {
        "function": "run",
        "source": "function run(configCallerResponse, personalizedSkillName) {\n  try {\n    configCallerResponse = JSON.parse(configCallerResponse);\n    let services = configCallerResponse.resource.items;\n    let item = services.find(item => item['name'] === 'Application');\n    let routerStructure = JSON.parse(item.value).settings.children;\n    \n    return routerStructure\n      .filter(item => item['shortName'])\n      .reduce((acc, item) => {\n        acc[item['service']] = item['shortName'];\n        return acc;\n      }, {});\n  } catch (e) {\n    return {};\n  }\n}",
        "inputVariables": [
          "configCallerResponse"
        ],
        "outputVariable": "serviceNames",
        "LocalTimeZoneEnabled": false
      }
    },
