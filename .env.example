# Banco de migration e seed: papel dono das tabelas.
DATABASE_URL=postgres://pipe:pipe@localhost:5433/pipe
# Banco da aplicação: papel sem bypassrls, sujeito à política tenant_isolado.
DATABASE_URL_APP=postgres://pipe_app:pipe_app@localhost:5433/pipe
REDIS_URL=redis://localhost:6380

# IA (@pipe/ai). Sem esta chave, resumo, classificação e avaliação não rodam.
ANTHROPIC_API_KEY=sk-ant-...
# Modelo padrão do pacote de IA. Vazio ou ausente usa claude-sonnet-5.
# Só use modelo com preço cadastrado em packages/ai/src/consumo/index.ts.
PIPE_IA_MODELO=claude-sonnet-5

# --- API (apps/api) ---
# 3000 e não 3100: a Gestão roda em 3100, o Desk em 3200 e o CRM em 3300. Duas coisas
# na mesma porta custa meia hora atrás de um login que "não faz nada".
PORT=3000
# Limite do corpo da requisição. O webhook da Meta cabe folgado em 2mb.
PIPE_LIMITE_CORPO=2mb
# `bullmq` (padrão) ou `memoria`. No modo memória a entrada é processada em linha,
# sem Redis: serve a desenvolvimento e ao teste de ponta a ponta.
PIPE_FILAS=bullmq
# Aparece em `GET /saude`. A imagem carimba a tag do build aqui.
PIPE_VERSAO=0.1.0
# Tempo-limite das sondas de `/saude`. Healthcheck que pendura é pior que healthcheck
# que falha: o orquestrador fica esperando em vez de tirar o contêiner de rotação.
PIPE_SAUDE_TIMEOUT_MS=2000

# --- Entrar com Google (apps/api + packages/autenticacao) ---
# Google Cloud Console → APIs e Serviços → Credenciais → ID do cliente OAuth (app web).
# A URL de retorno precisa bater EXATAMENTE com a cadastrada lá, inclusive a barra final.
GOOGLE_CLIENTE_ID=
GOOGLE_CLIENTE_SEGREDO=
GOOGLE_URL_RETORNO=http://localhost:3000/v1/auth/google/retorno

# Origens que podem chamar a API com credencial. Lista fechada, separada por vírgula,
# NUNCA curinga: com `credentials: true` o navegador recusa `*`, e mesmo que aceitasse
# seria abrir a API para qualquer site fazer requisição em nome de quem está logado.
PIPE_ORIGENS=http://localhost:3100,http://localhost:3200,http://localhost:3300
# Domínio-pai do cookie de sessão, com ponto na frente: `.usepipe.com.br`. É o que faz o
# cookie emitido por `api.usepipe.com.br` valer em `app.`, `gestao.` e `crm.`.
# VAZIO em desenvolvimento: `Domain=localhost` invalida o cookie em vários navegadores,
# e o sintoma é login que "não faz nada".
PIPE_COOKIE_DOMINIO=
# `false` só onde não há HTTPS (localhost). Em produção o cookie sai sempre com Secure.
PIPE_COOKIE_SEGURO=false
# Base das telas quando NÃO se sabe de qual dos três a pessoa veio. O caminho normal
# é o `?origem=` que cada front manda na ida, conferido contra PIPE_ORIGENS; isto é o
# fallback, e por isso aponta para a Gestão.
PIPE_URL_APP=http://localhost:3100
# Tela de entrada. É aqui que caem os erros de login, com `?erro=<codigo>` — os códigos
# são os de `RECUSAS_DE_ENTRADA` em packages/contracts/src/sessao.ts.
PIPE_URL_ENTRADA=http://localhost:3100/entrar
# Base pública da API. Dela sai a URL de retorno do SSO — `<base>/v1/auth/sso/retorno` —
# que é a MESMA para todos os clientes e é o que cada um cola no IdP dele. Mudar isto
# depois de um cliente ligar o SSO quebra o login dele até ele recolar a URL nova.
PIPE_URL_API=http://localhost:3000

# --- Métricas (apps/api) ---
# `/metrics` ABERTO VAZA VOLUME DE CLIENTE: requisições por rota e profundidade de fila
# dizem quanto o Pipe movimenta. Com o token definido, a coleta exige
# `Authorization: Bearer <token>`; sem ele, só rede interna (loopback e faixas privadas).
# Atrás do Traefik o IP visto é o do proxy, que é privado — então em produção, TOKEN.
PIPE_METRICS_TOKEN=

# --- Entrega de mensagem (apps/workers) ---
# `duble` (padrão) ou `real`. O dublê simula a Cloud API: aceita a mensagem, devolve
# um wamid e manda os status de volta pelo webhook, como a Meta faria.
PIPE_WHATSAPP_CLIENTE=duble
PIPE_ENTREGA_MAX_TENTATIVAS=5
PIPE_ENTREGA_ESPERA_BASE_MS=5000
PIPE_ENTREGA_ESPERA_TETO_MS=900000
PIPE_ENTREGA_CONCORRENCIA=4
PIPE_ENTREGA_VARREDURA_MS=15000
# Cron da agregação diária de `metrica_diaria` (dia anterior).
PIPE_AGREGACAO_CRON=10 3 * * *
PIPE_FUSO_PADRAO=America/Sao_Paulo
# Base pública do storage de objetos: `anexo.chave_storage` é concatenada aqui para
# virar o `link` que a Meta baixa.
PIPE_STORAGE_URL_BASE=http://localhost:9000/pipe

# --- Cifra dos segredos de canal ---
# O token da Meta, o appSecret e a senha de SMTP vivem cifrados em `canal.config`.
# Com o token, qualquer um manda mensagem PELO NÚMERO DO CLIENTE — e um dump do
# banco sem cifra entrega a credencial de todos os clientes de uma vez.
#
# Formato: `<id>:<32 bytes em base64>`, separado por vírgula. O id fica dentro de
# cada valor cifrado, então rotacionar é adicionar a chave nova como atual e
# manter a antiga na lista até tudo ter sido regravado.
#
# Gerar uma: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# Em produção elas chegam pelo SOPS, nunca por arquivo versionado.
PIPE_CHAVES_SEGREDO=
PIPE_CHAVE_SEGREDO_ATUAL=k1
# Teto de conversas atribuídas sem 1ª resposta por atendente. Vazio desliga o teto.
PIPE_TETO_SEM_PRIMEIRA_RESPOSTA=

# --- Dublê do WhatsApp (só vale com PIPE_WHATSAPP_CLIENTE=duble) ---
PIPE_WHATSAPP_DUBLE_ATRASO_MS=0
# Telefones (E.164 sem `+`, separados por vírgula) que sempre falham.
PIPE_WHATSAPP_DUBLE_FALHAR_PARA=
PIPE_WHATSAPP_DUBLE_FALHA_PERMANENTE=true
PIPE_WHATSAPP_DUBLE_CODIGO=131026
PIPE_WHATSAPP_DUBLE_TEXTO=

# --- WhatsApp Cloud API: o que a Meta exige quando houver conta real ---
#
# Estas quatro variáveis são o **fallback**. O lugar certo delas é `canal.config`
# (jsonb cifrado em repouso, §6 da spec), com as chaves `phoneNumberId`,
# `tokenAcesso`, `appSecret`, `verifyToken` e `apiVersao` — é assim que dois números
# de WhatsApp convivem no mesmo tenant. O ambiente serve a instalação de um número só.
#
# Onde cada uma nasce, no painel da Meta:
# - WHATSAPP_PHONE_NUMBER_ID: WhatsApp Manager → API Setup → "Phone number ID".
#   Não é o número de telefone; é o id numérico dele.
# - WHATSAPP_WABA_ID: id da WhatsApp Business Account. Necessário para ler e
#   sincronizar templates e para consultar tier e qualidade do número.
# - WHATSAPP_TOKEN_ACESSO: token de **usuário de sistema** do Business Manager, com
#   as permissões `whatsapp_business_messaging` e `whatsapp_business_management`.
#   Token de usuário comum expira em 24h e não serve para produção.
# - WHATSAPP_APP_SECRET: App Dashboard → Configurações → Básico → "Chave secreta do
#   app". É o segredo do HMAC de `X-Hub-Signature-256`. Sem ele o webhook de entrada
#   recusa tudo — de propósito: sem segredo não há como distinguir a Meta de qualquer um.
# - WHATSAPP_VERIFY_TOKEN: string que você inventa e repete no campo "Verify token"
#   ao cadastrar a URL do webhook. A Meta a devolve uma vez, no desafio de inscrição.
#
# A URL a cadastrar na Meta é `https://<host>/webhooks/whatsapp/<id do canal>`, com
# os campos `messages` assinados.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_TOKEN_ACESSO=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# A Meta descontinua versão antiga com aviso curto; por isso é configuração.
WHATSAPP_API_VERSAO=v21.0

# --- Conectar o WhatsApp do cliente (cadastro embutido da Meta) ---
#
# `duble` (padrão) ou `real`, como o `PIPE_WHATSAPP_CLIENTE` da entrega. O dublê
# simula o Graph inteiro: troca o código, inventa WABA e número determinísticos a
# partir do código, e registra o override em memória. É o que permite exercitar
# entrar → conectar → receber ANTES de a Meta aprovar o aplicativo.
PIPE_WHATSAPP_CONEXAO=duble
# App Dashboard → Configurações → Básico → "ID do aplicativo". Junto com
# WHATSAPP_APP_SECRET é o que troca o `code` do cadastro embutido pelo token do
# CLIENTE — o WABA é dele, o aplicativo é nosso (spec de infraestrutura §5).
# Só é lido com PIPE_WHATSAPP_CONEXAO=real.
WHATSAPP_APP_ID=

# --- Webhooks de saída (apps/api) ---
PIPE_WEBHOOK_MAX_TENTATIVAS=5
PIPE_WEBHOOK_TIMEOUT_MS=5000
