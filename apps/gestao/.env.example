# Dev local: mesmos valores de `.env.example` da raiz. O app fala com o banco pelo
# papel `pipe_app`, que **não** tem bypassrls — é o `comTenant` que libera as linhas.
DATABASE_URL=postgres://pipe:pipe@localhost:5433/pipe
DATABASE_URL_APP=postgres://pipe_app:pipe_app@localhost:5433/pipe

# Onde vive o app do atendente. O rodapé da lateral, o menu da conta e a coluna
# de Ações da tabela apontam para cá.
NEXT_PUBLIC_PIPE_DESK_URL=http://localhost:3200

# --- Sessão (substitui PIPE_TENANT_SLUG, que saiu) ---
# Quem é o tenant e quem é a pessoa vem do cookie `pipe_sessao`, resolvido pela `api`
# em `GET /v1/eu`. Sem sessão, a tela manda para `/entrar`.
# A `api` vista por ESTE servidor. Atrás de proxy, é o nome interno do serviço.
PIPE_URL_API=http://localhost:3000
# A mesma `api` vista pelo NAVEGADOR: é para cá que o botão "Entrar com Google" aponta,
# e navegação de topo não passa por este servidor. Em dev as duas são iguais; em
# produção esta é a pública (`https://api.usepipe.com.br`) e a de cima é a interna.
PIPE_URL_API_PUBLICA=http://localhost:3000
# Domínio-pai do cookie, IGUAL ao da `api` (`.usepipe.com.br`). É com ele que o "Sair"
# apaga o cookie certo; com o domínio errado o navegador guarda um segundo cookie vazio
# e a pessoa "sai" sem sair. VAZIO em desenvolvimento.
PIPE_COOKIE_DOMINIO=
# `false` só onde não há HTTPS (localhost).
PIPE_COOKIE_SEGURO=false
# ESTE aplicativo, visto pelo navegador. Vai na ida do login como `?origem=`, e é o
# que faz a volta cair aqui e não no front de outro módulo. Precisa estar em
# `PIPE_ORIGENS` da API, senão a volta cai no fallback `PIPE_URL_APP`.
PIPE_URL_ESTE_APP=http://localhost:3100
