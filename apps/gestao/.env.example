# Dev local: mesmos valores de `.env.example` da raiz. O app fala com o banco pelo
# papel `pipe_app`, que **não** tem bypassrls — é o `comTenant` que libera as linhas.
DATABASE_URL=postgres://pipe:pipe@localhost:5433/pipe
DATABASE_URL_APP=postgres://pipe_app:pipe_app@localhost:5433/pipe
# Opcional: fixa o tenant. Sem isso, o app resolve pelo slug abaixo na primeira consulta.
# PIPE_TENANT_ID=
PIPE_TENANT_SLUG=demo

# Onde vive o app do atendente. O rodapé da lateral, o menu da conta e a coluna
# de Ações da tabela apontam para cá.
NEXT_PUBLIC_PIPE_DESK_URL=http://localhost:3200
