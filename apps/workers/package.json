{
  "name": "@pipe/workers",
  "version": "0.1.0",
  "private": true,
  "description": "Filas BullMQ: entrega de mensagem e agregações",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./whatsapp": {
      "types": "./dist/whatsapp/index.d.ts",
      "default": "./dist/whatsapp/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@pipe/core": "workspace:*",
    "@pipe/db": "workspace:*",
    "bullmq": "^5.60.0",
    "drizzle-orm": "^0.44.6",
    "ioredis": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
