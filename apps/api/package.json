{
  "name": "@pipe/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST + webhooks; dono das regras de domínio",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dominio/fluxo": {
      "types": "./dist/dominio/fluxo.d.ts",
      "default": "./dist/dominio/fluxo.js"
    },
    "./dominio/gestao/builder-do-fluxo": {
      "types": "./dist/dominio/gestao/builder-do-fluxo.d.ts",
      "default": "./dist/dominio/gestao/builder-do-fluxo.js"
    },
    "./dominio/conversa": {
      "types": "./dist/dominio/conversa.d.ts",
      "default": "./dist/dominio/conversa.js"
    },
    "./dominio/envio": {
      "types": "./dist/dominio/envio.d.ts",
      "default": "./dist/dominio/envio.js"
    },
    "./dominio/assumir": {
      "types": "./dist/dominio/assumir.d.ts",
      "default": "./dist/dominio/assumir.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "provisionar": "tsx src/provisionar.ts",
    "importar:fluxo": "tsx src/importar-fluxo.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@pipe/armazenamento": "workspace:*",
    "@pipe/autenticacao": "workspace:*",
    "@pipe/contracts": "workspace:*",
    "@pipe/core": "workspace:*",
    "@pipe/db": "workspace:*",
    "@pipe/workers": "workspace:*",
    "bullmq": "^5.60.0",
    "drizzle-orm": "^0.44.6",
    "express": "^5.1.0",
    "ioredis": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
