{
  "name": "@pipe/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST + webhooks; dono das regras de domínio",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain/flow": {
      "types": "./dist/domain/flow.d.ts",
      "default": "./dist/domain/flow.js"
    },
    "./domain/management/flow-builder": {
      "types": "./dist/domain/management/builder-of-flow.d.ts",
      "default": "./dist/domain/management/builder-of-flow.js"
    },
    "./domain/management/name-rules": {
      "types": "./dist/domain/management/regras-de-nome.d.ts",
      "default": "./dist/domain/management/regras-de-nome.js"
    },
    "./domain/conversation": {
      "types": "./dist/domain/conversation.d.ts",
      "default": "./dist/domain/conversation.js"
    },
    "./domain/sending": {
      "types": "./dist/domain/envio.d.ts",
      "default": "./dist/domain/envio.js"
    },
    "./domain/assume": {
      "types": "./dist/domain/assumir.d.ts",
      "default": "./dist/domain/assumir.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --no-node-snapshot src/main.ts",
    "provision": "tsx src/provision.ts",
    "import:flow": "tsx src/import-flow.ts",
    "start": "node --no-node-snapshot dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@pipe/ai": "workspace:*",
    "@pipe/authentication": "workspace:*",
    "@pipe/contracts": "workspace:*",
    "@pipe/core": "workspace:*",
    "@pipe/db": "workspace:*",
    "@pipe/storage": "workspace:*",
    "@pipe/workers": "workspace:*",
    "bullmq": "^5.60.0",
    "drizzle-orm": "^0.44.6",
    "express": "^5.1.0",
    "ioredis": "^5.9.0",
    "isolated-vm": "6.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
