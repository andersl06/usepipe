infra/observability/alertmanager.yml,1,comment,,# Roteamento. A única coisa que importa aqui: `acorda` sai por um canal que,,
infra/observability/alertmanager.yml,2,comment,,"# realmente acorda alguém, e `ticket` sai por e-mail. Se os dois saírem pelo mesmo",,
infra/observability/alertmanager.yml,3,comment,,"# lugar, em duas semanas os dois estão silenciados.",,
infra/observability/alertmanager.yml,13,comment,,# 4 horas entre repetições: alerta que repete de 5 em 5 minutos ensina a ignorar.,,
infra/observability/alertmanager.yml,16,identifier,severidade,"- matchers: [severidade=""acorda""]",,
infra/observability/alertmanager.yml,20,comment,,"# Dois tópicos de ntfy, e não e-mail + ntfy, por um motivo prático: o receptor de",,
infra/observability/alertmanager.yml,22,comment,,# nunca montou. O Alertmanager RECUSA a configuração inteira quando o caminho não,,
infra/observability/alertmanager.yml,23,comment,,"# existe — ele não subia, e a pilha subia inteira sem ninguém vigiando.",,
infra/observability/alertmanager.yml,25,comment,,# Dois tópicos separados custam zero credencial e mantêm a separação que importa:,,
infra/observability/alertmanager.yml,26,comment,,"# no celular, `pipe-acorda` fica como notificação de prioridade máxima, furando o",,
infra/observability/alertmanager.yml,27,comment,,"# ""não perturbe"", e `pipe-ticket` fica silencioso, para ler de manhã. Um só tópico",,
infra/observability/alertmanager.yml,28,comment,,"# para os dois é como, em duas semanas, os dois estão silenciados.",,
infra/observability/alertmanager.yml,30,comment,,# TROQUE o sufixo dos dois: tópico do ntfy.sh é público para quem souber o nome.,,
infra/observability/alertmanager.yml,37,comment,,# Requisito deste: precisa furar o modo silencioso do celular. Notificação que,,
infra/observability/alertmanager.yml,38,comment,,"# respeita o ""não perturbe"" não é plantão, é histórico.",,
infra/observability/alertmanager.yml,45,comment,,"# Quando a máquina inteira cai, tudo cai junto. Sem isto, o celular recebe doze",,
infra/observability/alertmanager.yml,46,comment,,# mensagens e a primeira — a que diz o que houve — some no meio.,,
infra/observability/alertmanager.yml,47,identifier,fora,"- source_matchers: [alertname=""ApiForaDoAr""]",,
infra/observability/alertmanager.yml,48,identifier,severidade,"target_matchers: [severidade=""ticket""]",,
infra/observability/prometheus.yml,1,comment,,"# Coleta do degrau pequeno. Vale para o grande também, trocando os alvos fixos",,
infra/observability/prometheus.yml,2,comment,,# por descoberta de serviço — as regras de alerta são as mesmas nos dois.,,
infra/observability/prometheus.yml,8,identifier,producao,ambiente: producao,,
infra/observability/prometheus.yml,11,identifier,alertas,- /etc/prometheus/alertas.yml,,
infra/observability/prometheus.yml,20,comment,,# `/metrics` existe (apps/api/src/controladores/operacao.ts) e é daqui que saem,,
infra/observability/prometheus.yml,25,comment,,"# A coleta é por dentro da rede, de um IP privado, e é por isso que ela passa",,
infra/observability/prometheus.yml,32,comment,,# NÃO existe alvo `pipe-workers`. `apps/workers` não abre porta HTTP nenhuma,,
infra/observability/prometheus.yml,33,comment,,# (nenhum `createServer` no código) e o Dockerfile dele não tem EXPOSE. Um job,,
infra/observability/prometheus.yml,34,comment,,# apontando para `workers:9464` ficaria `up == 0` para sempre — e o alerta,,
infra/observability/prometheus.yml,35,comment,,"# `WorkerParado`, que é `severidade: acorda`, tocaria o telefone toda noite",,
infra/observability/prometheus.yml,36,comment,,# desde o primeiro dia. Alerta que toca sem ação é como se ensina a ignorar,,
infra/observability/prometheus.yml,37,comment,,# todos os outros. Volta quando os workers expuserem métrica de verdade.,,
infra/observability/prometheus.yml,51,comment,,# O node-exporter lê /metricas via textfile collector: é por onde entram as,,
infra/observability/prometheus.yml,52,comment,,# métricas de backup e de teste de restauração escritas pelos scripts.,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,2,comment,,"# Estado inicial da máquina. Só o que não muda: Docker, firewall, diretórios e os",,
infra/terraform/modules/vps-pipe/cloud-init.yaml,3,comment,,"# dois timers. Código e segredo chegam depois, pelo deploy — não pelo cloud-init,",,
infra/terraform/modules/vps-pipe/cloud-init.yaml,4,comment,,# senão recriar a máquina viraria um jeito acidental de publicar versão velha.,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,12,identifier,decifra,- age        # decifra os segredos SOPS no deploy,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,12,identifier,segredos,- age        # decifra os segredos SOPS no deploy,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,16,comment,,"# O backup roda como timer do sistema, não como container em laço: se o Docker",,
infra/terraform/modules/vps-pipe/cloud-init.yaml,17,comment,,"# cair, o timer ainda dispara e o alerta de ""backup não rodou"" aparece.",,
infra/terraform/modules/vps-pipe/cloud-init.yaml,25,comment,,# `--env-file` não é opcional: sem ele o compose não resolve ${POSTGRES_SENHA},,
infra/terraform/modules/vps-pipe/cloud-init.yaml,27,comment,,"# com ""authentication failed"". `--profile tarefa` porque o serviço vive nele.",,
infra/terraform/modules/vps-pipe/cloud-init.yaml,28,identifier,dados,ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml --env-file /opt/pipe-dados/.env --profile tarefa run --rm b,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,32,identifier,diario,Description=Backup diário,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,38,comment,,"# Restauração testada é requisito da §7 da spec de infraestrutura. Semanal, não",,
infra/terraform/modules/vps-pipe/cloud-init.yaml,39,comment,,# mensal: o custo é um container efêmero e a diferença é descobrir o problema,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,40,comment,,# três semanas antes.,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,41,identifier,restauracao,- path: /etc/systemd/system/pipe-restauracao-teste.service,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,41,identifier,teste,- path: /etc/systemd/system/pipe-restauracao-teste.service,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,48,identifier,dados,ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml --env-file /opt/pipe-dados/.env --profile tarefa run --rm b,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,49,identifier,restauracao,- path: /etc/systemd/system/pipe-restauracao-teste.timer,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,49,identifier,teste,- path: /etc/systemd/system/pipe-restauracao-teste.timer,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,52,identifier,restauracao,Description=Teste semanal de restauração,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,52,identifier,semanal,Description=Teste semanal de restauração,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,52,identifier,teste,Description=Teste semanal de restauração,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,60,identifier,com,- curl -fsSL https://get.docker.com | sh,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,61,comment,,"# `sops` NÃO está no apt do Ubuntu — só o `age` está, e é por isso que o",,
infra/terraform/modules/vps-pipe/cloud-init.yaml,62,comment,,"# deploy.sh morria em ""sops: command not found"" na primeira execução. Binário",,
infra/terraform/modules/vps-pipe/cloud-init.yaml,63,comment,,"# único, sem dependência.",,
infra/terraform/modules/vps-pipe/cloud-init.yaml,64,identifier,com,- curl -fsSLo /usr/local/bin/sops https://github.com/getsops/sops/releases/download/v3.9.4/sops-v3.9.4.linux.amd64,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,66,comment,,"# Postgres e Redis nunca escutam na rede pública; o firewall é a segunda tranca,",,
infra/terraform/modules/vps-pipe/cloud-init.yaml,67,comment,,# a primeira é não publicar porta no compose.,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,73,identifier,dados,- mkdir -p /opt/pipe /opt/pipe-dados/acme,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,74,identifier,dados,- touch /opt/pipe-dados/acme/acme.json && chmod 600 /opt/pipe-dados/acme/acme.json,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,77,identifier,restauracao,- systemctl enable --now pipe-backup.timer pipe-restauracao-teste.timer,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,77,identifier,teste,- systemctl enable --now pipe-backup.timer pipe-restauracao-teste.timer,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,78,comment,,"# O que falta é manual, uma vez só, e está em docs/specs/2026-09-07-implantacao.md:",,
infra/terraform/modules/vps-pipe/cloud-init.yaml,80,comment,,"# 2) rodar infra/compose/bootstrap.sh <versao>, que confere o que precisa estar",,
infra/terraform/modules/vps-pipe/cloud-init.yaml,81,comment,,"#    pronto, sobe a pilha na ordem certa e para com mensagem no que é seu.",,
infra/terraform/modules/vps-pipe/cloud-init.yaml,83,comment,,# O `ufw` acima NÃO fecha porta publicada por contêiner: o Docker escreve direto,,
infra/terraform/modules/vps-pipe/cloud-init.yaml,84,comment,,"# no netfilter, antes das regras dele. Aqui isso não é problema porque só o",,
infra/terraform/modules/vps-pipe/cloud-init.yaml,85,comment,,# Traefik publica porta (80 e 443) — mas vale lembrar antes de alguém acrescentar,,
