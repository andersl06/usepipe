infra/compose/deploy.sh,2,comment,,"# Publicação de uma versão nova. Roda na VPS, como root, a partir de /opt/pipe.",,
infra/compose/deploy.sh,4,comment,,"# Este script é para a SEGUNDA publicação em diante. A primeira, do zero, é",,
infra/compose/deploy.sh,5,comment,,"# `bootstrap.sh` — ela tem passos que só acontecem uma vez (papel do banco,",,
infra/compose/deploy.sh,6,comment,,"# stanza do backup, tenant, canal) e paradas para o que só o dono pode fazer.",,
infra/compose/deploy.sh,8,comment,,"# A ordem não é gosto: migration antes do código novo (§9 da spec), porque só",,
infra/compose/deploy.sh,9,comment,,# assim dá para voltar a versão anterior sem perder dado. Toda migration precisa,,
infra/compose/deploy.sh,10,comment,,"# ser compatível com o código antigo — este script não tem como verificar isso, e",,
infra/compose/deploy.sh,11,comment,,# é a única regra aqui que depende de disciplina humana.,,
infra/compose/deploy.sh,14,identifier,imagem,"VERSAO=""${1:?uso: deploy.sh <tag da imagem>}""",,
infra/compose/deploy.sh,14,identifier,versao,"VERSAO=""${1:?uso: deploy.sh <tag da imagem>}""",,
infra/compose/deploy.sh,17,comment,,# Segredo nunca fica em disco versionado. O arquivo cifrado vive no repositório;,,
infra/compose/deploy.sh,18,comment,,"# a chave age vive só na máquina, com dono root e modo 600.",,
infra/compose/deploy.sh,19,identifier,dados,export SOPS_AGE_KEY_FILE=/opt/pipe-dados/age.key,,
infra/compose/deploy.sh,21,identifier,dados,sops --decrypt secrets/production.enc.env > /opt/pipe-dados/.env,,
infra/compose/deploy.sh,22,comment,,"# Depois do arquivo cifrado, de propósito: em `--env-file` vale a última",,
infra/compose/deploy.sh,23,comment,,"# definição, então esta linha sobrescreve o PIPE_VERSAO que veio do SOPS.",,
infra/compose/deploy.sh,24,identifier,dados,"echo ""PIPE_VERSAO=${VERSAO}"" >> /opt/pipe-dados/.env",,
infra/compose/deploy.sh,24,identifier,versao,"echo ""PIPE_VERSAO=${VERSAO}"" >> /opt/pipe-dados/.env",C,D-06/D-36
infra/compose/deploy.sh,26,identifier,dados,"COMPOSE=""docker compose -f docker-compose.prod.yml --env-file /opt/pipe-dados/.env""",,
infra/compose/deploy.sh,28,comment,,"# `postgres` e `backup` são construídos aqui, não puxados: a imagem é o Postgres",,
infra/compose/deploy.sh,29,comment,,"# com pgbackrest ao lado, e ela não está em registro nenhum. `--ignore-buildable`",,
infra/compose/deploy.sh,30,comment,,# impede que o `pull` pare a publicação tentando baixar justamente essas duas.,,
infra/compose/deploy.sh,34,identifier,migrar,$COMPOSE --profile tarefa run --rm migrar,,
infra/compose/deploy.sh,37,comment,,"# sem ele, ""deploy ok"" significa apenas ""o contêiner iniciou"", que é diferente de",,
infra/compose/deploy.sh,38,comment,,"# ""o contêiner responde"".",,
infra/compose/deploy.sh,41,comment,,# Registro de publicação que o suporte consiga consultar às duas da manhã.,,
