infra/k8s/base/web.yaml,55,comment,,"# assadas no bundle pela imagem (`apps/management-vite/Dockerfile`, build-arg). A",,
infra/k8s/base/web.yaml,56,comment,,"# porta do contêiner é a 80 do nginx, não a 3000 do Next.",,
