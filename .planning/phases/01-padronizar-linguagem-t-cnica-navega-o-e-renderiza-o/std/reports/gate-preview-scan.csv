infra/compose/docker-compose.prod.yml,176,comment,,"# Gestão como SPA estática (Vite + nginx): não fala com o Postgres, não lê",,
infra/compose/docker-compose.prod.yml,177,comment,,"# `.env`, não tem `PIPE_URL_ESTE_APP` — a origem do próprio app já sai",,
infra/compose/docker-compose.prod.yml,179,comment,,"# quem decide ""para onde volto depois do login"" é o navegador",,
infra/compose/docker-compose.prod.yml,180,comment,,"# (`window.location.origin`), não uma variável de servidor. Por isso está só",,
infra/compose/docker-compose.prod.yml,181,comment,,"# na rede `borda`, como o `site`, e não em `dados`.",,
