infra/compose/deploy.sh,2,comment,,"# Publicação de uma versão nova. Roda na VPS, como root, a partir de /opt/pipe.",,
infra/compose/deploy.sh,4,comment,,"# Este script é para a SEGUNDA publicação em diante. A primeira, do zero, é",,
infra/compose/deploy.sh,5,comment,,"# `bootstrap.sh` — ela tem passos que só acontecem uma vez (papel do banco,",,
infra/compose/deploy.sh,6,comment,,"# stanza do backup, tenant, canal) e paradas para o que só o dono pode fazer.",,
infra/compose/deploy.sh,8,comment,,"# A ordem não é gosto: migration antes do código novo (§9 da spec), porque só",,
infra/compose/deploy.sh,9,comment,,# assim dá para voltar a versão anterior sem perder dado. Toda migration precisa,,
infra/compose/deploy.sh,10,comment,,"# ser compatível com o código antigo — este script não tem como verificar isso, e",,
infra/compose/deploy.sh,11,comment,,# é a única regra aqui que depende de disciplina humana.,,
infra/compose/deploy.sh,14,identifier,imagem,"VERSAO=""${1:?uso: deploy.sh <tag da imagem>}""",,
infra/compose/deploy.sh,14,identifier,versao,"VERSAO=""${1:?uso: deploy.sh <tag da imagem>}""",,
infra/compose/deploy.sh,17,comment,,# Segredo nunca fica em disco versionado. O arquivo cifrado vive no repositório;,,
infra/compose/deploy.sh,18,comment,,"# a chave age vive só na máquina, com dono root e modo 600.",,
infra/compose/deploy.sh,19,identifier,dados,export SOPS_AGE_KEY_FILE=/opt/pipe-dados/age.key,,
infra/compose/deploy.sh,21,identifier,dados,sops --decrypt secrets/production.enc.env > /opt/pipe-dados/.env,,
infra/compose/deploy.sh,22,comment,,"# Depois do arquivo cifrado, de propósito: em `--env-file` vale a última",,
infra/compose/deploy.sh,23,comment,,"# definição, então esta linha sobrescreve o PIPE_VERSAO que veio do SOPS.",,
infra/compose/deploy.sh,24,identifier,dados,"echo ""PIPE_VERSAO=${VERSAO}"" >> /opt/pipe-dados/.env",,
infra/compose/deploy.sh,24,identifier,versao,"echo ""PIPE_VERSAO=${VERSAO}"" >> /opt/pipe-dados/.env",C,D-06/D-36
infra/compose/deploy.sh,27,identifier,dados,source /opt/pipe-dados/.env,,
infra/compose/deploy.sh,31,identifier,dados,"COMPOSE=""docker compose -f docker-compose.prod.yml -f docker-compose.tls-${PIPE_TLS_MODE}.yml --env-file /opt/pipe-dados",,
infra/compose/deploy.sh,33,comment,,"# `postgres` e `backup` são construídos aqui, não puxados: a imagem é o Postgres",,
infra/compose/deploy.sh,34,comment,,"# com pgbackrest ao lado, e ela não está em registro nenhum. `--ignore-buildable`",,
infra/compose/deploy.sh,35,comment,,# impede que o `pull` pare a publicação tentando baixar justamente essas duas.,,
infra/compose/deploy.sh,39,identifier,migrar,$COMPOSE --profile tarefa run --rm migrar,,
infra/compose/deploy.sh,41,comment,,# `--wait` faz o compose esperar o healthcheck ficar verde antes de dar por feito;,,
infra/compose/deploy.sh,42,comment,,"# sem ele, ""deploy ok"" significa apenas ""o contêiner iniciou"", que é diferente de",,
infra/compose/deploy.sh,43,comment,,"# ""o contêiner responde"".",,
infra/compose/deploy.sh,46,comment,,# Registro de publicação que o suporte consiga consultar às duas da manhã.,,
infra/compose/deploy.sh,47,identifier,dados,"printf '%s\t%s\t%s\n' ""$(date -Is)"" ""${VERSAO}"" ""${SUDO_USER:-root}"" >> /opt/pipe-dados/publicacoes.tsv",,
infra/compose/deploy.sh,47,identifier,publicacoes,"printf '%s\t%s\t%s\n' ""$(date -Is)"" ""${VERSAO}"" ""${SUDO_USER:-root}"" >> /opt/pipe-dados/publicacoes.tsv",,
infra/compose/deploy.sh,47,identifier,versao,"printf '%s\t%s\t%s\n' ""$(date -Is)"" ""${VERSAO}"" ""${SUDO_USER:-root}"" >> /opt/pipe-dados/publicacoes.tsv",,
infra/compose/docker-compose.prod.yml,1,comment,,# Pipe em produção numa máquina só — o degrau pequeno.,,
infra/compose/docker-compose.prod.yml,3,comment,,"# Diferenças em relação ao docker-compose.yml da raiz, que é de desenvolvimento:",,
infra/compose/docker-compose.prod.yml,5,comment,,"# de CPU e memória por serviço, healthcheck em tudo que recebe tráfego, e o",,
infra/compose/docker-compose.prod.yml,6,comment,,# backup como serviço de verdade.,,
infra/compose/docker-compose.prod.yml,9,comment,,# O .env é gerado pelo deploy.sh a partir do arquivo SOPS; nunca é versionado.,,
infra/compose/docker-compose.prod.yml,13,identifier,padrao,x-padrao: &padrao,,
infra/compose/docker-compose.prod.yml,15,comment,,# Log sem rotação enche o disco da VPS em semanas e derruba o Postgres junto.,,
infra/compose/docker-compose.prod.yml,23,identifier,padrao,<<: *padrao,,
infra/compose/docker-compose.prod.yml,24,identifier,dados,env_file: [/opt/pipe-dados/.env],,
infra/compose/docker-compose.prod.yml,28,identifier,dados,"networks: [borda, dados]",,
infra/compose/docker-compose.prod.yml,29,comment,,# Tetos calculados para uma VPS de 4 vCPU / 16 GB. A soma dos limites passa do,,
infra/compose/docker-compose.prod.yml,30,comment,,# total de propósito: nem todos chegam no teto ao mesmo tempo. O que não pode,,
infra/compose/docker-compose.prod.yml,31,comment,,"# faltar é o teto — sem ele, um vazamento no worker mata o Postgres junto.",,
infra/compose/docker-compose.prod.yml,32,comment,,"# deploy.resources vale no `docker compose up`, sem Swarm nenhum.",,
infra/compose/docker-compose.prod.yml,42,comment,,"# O HEALTHCHECK das duas imagens Next que restam (`desk`, `crm`) sai com",,
infra/compose/docker-compose.prod.yml,43,comment,,"# `exit 0` em QUALQUER resposta HTTP, 500 inclusive: um front sem banco fica",,
infra/compose/docker-compose.prod.yml,44,comment,,"# ""healthy"" para sempre. Aqui a raiz é aceita só abaixo de 500. Não é `/saude`",,
infra/compose/docker-compose.prod.yml,45,comment,,"# — Next não tem uma —, mas já separa ""o processo subiu"" de ""o processo",,
infra/compose/docker-compose.prod.yml,46,comment,,"# consegue renderizar"". `management-vite` não usa isto: é estático, sem banco para",,
infra/compose/docker-compose.prod.yml,47,comment,,"# falhar, e o HEALTHCHECK da própria imagem (`apps/management-vite/Dockerfile`) já",,
infra/compose/docker-compose.prod.yml,52,identifier,cmd,"'CMD',",,
infra/compose/docker-compose.prod.yml,64,identifier,padrao,<<: *padrao,,
infra/compose/docker-compose.prod.yml,68,comment,,"# Sem isto, todo contêiner novo vira rota publicada por acidente.",,
infra/compose/docker-compose.prod.yml,70,comment,,"# `api`, `desk` e `crm` estão em DUAS redes (`management-vite` não: é estático,",,
infra/compose/docker-compose.prod.yml,71,comment,,"# não fala com o Postgres, e vive só na `borda`). Sem esta linha o Traefik",,
infra/compose/docker-compose.prod.yml,72,comment,,# escolhe um dos dois IPs sem critério estável nos que estão em duas — e,,
infra/compose/docker-compose.prod.yml,73,comment,,"# quando escolhe o da rede `dados`, onde ele não está, dá 502 que some e",,
infra/compose/docker-compose.prod.yml,74,comment,,# volta a cada recriação de contêiner. O nome tem o prefixo do projeto,,
infra/compose/docker-compose.prod.yml,81,comment,,"# ACME por desafio HTTP: não exige token de DNS na máquina, e a porta 80 já",,
infra/compose/docker-compose.prod.yml,91,comment,,"# Somente leitura: o Traefik precisa descobrir contêiner, não controlar o",,
infra/compose/docker-compose.prod.yml,92,comment,,# Docker. Socket rw aqui é root na máquina para quem tomar o Traefik.,,
infra/compose/docker-compose.prod.yml,94,identifier,dados,- /opt/pipe-dados/acme:/acme,,
infra/compose/docker-compose.prod.yml,102,identifier,cmd,"test: ['CMD', 'traefik', 'healthcheck', '--ping']",,
infra/compose/docker-compose.prod.yml,109,comment,,# Construída por infra/build-images.sh a partir de apps/api/Dockerfile.,,
infra/compose/docker-compose.prod.yml,110,identifier,versao,image: ghcr.io/pipe/api:${PIPE_VERSAO},C,D-06/D-36
infra/compose/docker-compose.prod.yml,111,comment,,# `GET /saude` existe desde 07/09/2026 (apps/api/src/controladores/operacao.ts),,
infra/compose/docker-compose.prod.yml,112,comment,,# e devolve 503 quando o pool da aplicação não responde. O HEALTHCHECK da,,
infra/compose/docker-compose.prod.yml,113,comment,,# imagem ainda bate na raiz `/` e aprova qualquer coisa abaixo de 500 — o que,,
infra/compose/docker-compose.prod.yml,114,comment,,"# dá ""healthy"" com o banco fora. Este bloco sobrescreve o da imagem, e é a",,
infra/compose/docker-compose.prod.yml,115,comment,,"# diferença entre ""o contêiner iniciou"" e ""o contêiner atende"".",,
infra/compose/docker-compose.prod.yml,119,identifier,cmd,"'CMD',",,
infra/compose/docker-compose.prod.yml,130,comment,,"# `!PathPrefix('/metrics')`: o roteador é por Host, e sem esta negação",,
infra/compose/docker-compose.prod.yml,131,comment,,# `https://api.<dominio>/metrics` fica público. O porteiro da própria,,
infra/compose/docker-compose.prod.yml,132,comment,,"# rota libera faixa privada quando não há token, e atrás do Traefik o IP",,
infra/compose/docker-compose.prod.yml,133,comment,,"# visto É privado — ou seja, a defesa da aplicação não vale aqui. O",,
infra/compose/docker-compose.prod.yml,134,comment,,"# Prometheus continua coletando por dentro, em `api:3100`.",,
infra/compose/docker-compose.prod.yml,135,identifier,contas,- traefik.http.routers.api.rule=Host(`api.${PIPE_DOMINIO_CONTAS}`) && !PathPrefix(`/metrics`),C,D-06/D-36
infra/compose/docker-compose.prod.yml,135,identifier,dominio,- traefik.http.routers.api.rule=Host(`api.${PIPE_DOMINIO_CONTAS}`) && !PathPrefix(`/metrics`),C,D-06/D-36
