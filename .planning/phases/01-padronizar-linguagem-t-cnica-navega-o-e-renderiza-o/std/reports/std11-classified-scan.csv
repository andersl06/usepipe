infra/compose/docker-compose.prod.yml,356,identifier,dados,networks: [dados],,
infra/compose/docker-compose.prod.yml,363,identifier,cmd,"test: ['CMD', 'redis-cli', 'ping']",,
infra/compose/docker-compose.prod.yml,369,identifier,padrao,<<: *padrao,,
infra/compose/docker-compose.prod.yml,370,comment,,# Mesma imagem do banco de propósito: o teste de restauração precisa da MESMA,,
infra/compose/docker-compose.prod.yml,371,comment,,"# versão de Postgres e das MESMAS extensões, senão ele valida outra coisa.",,
infra/compose/docker-compose.prod.yml,375,comment,,"# `tarefa` porque este serviço EXISTE para ser chamado com `run --rm`, pelos",,
infra/compose/docker-compose.prod.yml,376,comment,,"# timers do systemd. Sem o perfil ele entrava no `up`, subia um `/bin/bash`",,
infra/compose/docker-compose.prod.yml,377,comment,,"# sem terminal, saía na hora — e o `up -d --wait` do deploy.sh dava a",,
infra/compose/docker-compose.prod.yml,378,comment,,# publicação inteira como falha por causa de um contêiner que fez o certo.,,
infra/compose/docker-compose.prod.yml,380,identifier,fica,"restart: 'no' # disparado por systemd timer, não fica em laço",,
infra/compose/docker-compose.prod.yml,380,identifier,nao,"restart: 'no' # disparado por systemd timer, não fica em laço",,
infra/compose/docker-compose.prod.yml,380,identifier,por,"restart: 'no' # disparado por systemd timer, não fica em laço",,
infra/compose/docker-compose.prod.yml,385,identifier,segredo,PGBACKREST_REPO1_S3_KEY_SECRET: ${BACKUP_S3_SEGREDO},C,D-06/D-36
infra/compose/docker-compose.prod.yml,386,comment,,"# `pgbackrest.conf` declara `repo1-cipher-type=aes-256-cbc`. Sem a senha,",,
infra/compose/docker-compose.prod.yml,387,comment,,"# todo comando do pgBackRest para com ""repo1-cipher-pass is required"" — e",,
infra/compose/docker-compose.prod.yml,391,identifier,restauracao,HEALTHCHECK_URL_RESTAURACAO: ${HEALTHCHECK_URL_RESTAURACAO},,
infra/compose/docker-compose.prod.yml,392,identifier,senha,PGPASSWORD: ${POSTGRES_SENHA},C,D-06/D-36
infra/compose/docker-compose.prod.yml,394,comment,,# PGDATA porque o pgBackRest lê os arquivos direto; a conexão libpq é só,,
