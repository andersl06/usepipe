infra/compose/docker-compose.prod.yml,139,identifier,dominio,- traefik.http.routers.api-tenant.rule=HostRegexp(`^[a-z0-9-]+\.(desk\.)?${PIPE_DOMINIO_CONTAS}$`) && PathPrefix(`/v1`),C,D-06/D-36
