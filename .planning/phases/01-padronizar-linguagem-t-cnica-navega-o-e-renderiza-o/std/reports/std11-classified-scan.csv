infra/k8s/values/postgres-cnpg.yaml,1,comment,,"# Postgres DENTRO do cluster — o plano B, não o padrão.",,
infra/k8s/values/postgres-cnpg.yaml,3,comment,,# O padrão é banco gerenciado fora do cluster (ver o módulo k8s-cluster). Este,,
infra/k8s/values/postgres-cnpg.yaml,5,comment,,#   1. o provedor não oferece pgvector no Postgres gerenciado — e sem pgvector o,,
infra/k8s/values/postgres-cnpg.yaml,6,comment,,#      pacote @pipe/ai não sobe;,,
infra/k8s/values/postgres-cnpg.yaml,7,comment,,#   2. o cliente exigiu que o dado não saia do cluster dele.,,
infra/k8s/values/postgres-cnpg.yaml,9,comment,,"# O CloudNativePG é bom software (CNCF, backup por plugin Barman, failover",,
infra/k8s/values/postgres-cnpg.yaml,10,comment,,"# automático, upgrade de versão maior declarativo). O que ele não resolve é quem",,
infra/k8s/values/postgres-cnpg.yaml,11,comment,,"# vai depurar às 3h um failover que não completou. Enquanto a resposta for ""uma",,
infra/k8s/values/postgres-cnpg.yaml,12,comment,,"# pessoa só"", pague o gerenciado.",,
infra/k8s/values/postgres-cnpg.yaml,27,comment,,# RLS depende de o papel da aplicação não ser dono e não ter bypassrls; quem,,
infra/k8s/values/postgres-cnpg.yaml,28,comment,,"# garante isso é a migration, não o operador.",,
infra/k8s/values/postgres-cnpg.yaml,31,comment,,"# Réplica síncrona: com 3 instâncias, confirmar a escrita em uma réplica",,
infra/k8s/values/postgres-cnpg.yaml,32,comment,,# significa que a queda do primário não perde transação já confirmada. Custa,,
infra/k8s/values/postgres-cnpg.yaml,33,comment,,"# latência de escrita, e é o preço de RPO zero para o que foi confirmado.",,
infra/k8s/values/postgres-cnpg.yaml,53,comment,,# Uma instância por nó: três réplicas no mesmo nó é uma réplica com passos extras.,,
infra/k8s/values/postgres-cnpg.yaml,58,comment,,"# Backup contínuo para storage de objetos, pelo plugin Barman Cloud. Sem isto o",,
infra/k8s/values/postgres-cnpg.yaml,59,comment,,"# cluster tem alta disponibilidade e NÃO tem backup — são coisas diferentes, e",,
infra/k8s/values/postgres-cnpg.yaml,60,comment,,# confundi-las é como se perde dado apagado por engano.,,
infra/k8s/values/traefik-values.yaml,3,comment,,"# Escolha forçada por um fato, não por preferência: o ingress-nginx mantido pelo",,
infra/k8s/values/traefik-values.yaml,4,comment,,"# projeto Kubernetes foi aposentado em março de 2026 — sem release, sem correção",,
infra/k8s/values/traefik-values.yaml,5,comment,,# de bug e sem correção de segurança.,,
infra/k8s/values/traefik-values.yaml,7,comment,,"# Entre os que sobraram, o Traefik é o mesmo do degrau pequeno: um jeito só de",,
infra/k8s/values/traefik-values.yaml,13,comment,,"# Sem PDB, a drenagem de um nó pode tirar as duas réplicas de ingress ao mesmo",,
infra/k8s/values/traefik-values.yaml,14,comment,,# tempo — indisponibilidade total durante uma manutenção rotineira.,,
infra/k8s/values/traefik-values.yaml,26,comment,,"# O IP precisa ser estável: é ele que está no DNS e, quando o cliente restringe",,
infra/k8s/values/traefik-values.yaml,27,comment,,"# saída por IP, na lista de permissão dele.",,
