infra/.sops.yaml,1,comment,,# Regras do SOPS. Rode `sops` a partir de `infra/` para que este arquivo valha.,,
infra/.sops.yaml,3,comment,,"# age em vez de GPG: chave de 60 caracteres, sem chaveiro, sem agente, sem data de",,
infra/.sops.yaml,4,comment,,# validade que expira no feriado. O segredo cifrado é versionado no repositório e,,
infra/.sops.yaml,5,comment,,"# o diff continua legível — muda uma linha, aparece uma linha.",,
infra/.sops.yaml,7,comment,,"# Duas destinatárias em toda regra, sempre:",,
infra/.sops.yaml,8,comment,,"#  - a do operador, que fica na máquina dele e numa cópia offline;",,
infra/.sops.yaml,9,comment,,"#  - a de deploy, que fica na VPS em /opt/pipe-dados/age.key e SÓ decifra.",,
infra/.sops.yaml,10,comment,,# Uma só significa que perder o notebook é perder produção.,,
infra/.sops.yaml,12,comment,,# Rotacionar destinatária: edite as chaves abaixo e rode,,
infra/.sops.yaml,14,comment,,# O conteúdo não muda; muda quem consegue abrir.,,
infra/.sops.yaml,27,comment,,"# Segredos do cluster: o kustomize-controller do Flux decifra sozinho, com a",,
infra/.sops.yaml,28,comment,,# chave guardada como Secret no cluster. Não é preciso outro operador para isso.,,
infra/build-images.sh,2,comment,,# Constrói as imagens do Pipe. Roda da raiz do repositório ou de qualquer lugar.,,
infra/build-images.sh,5,comment,,#   ./infra/build-images.sh v1.4.2 api      # só a API,,
infra/build-images.sh,8,comment,,# A versão é obrigatória e vira a tag que o docker-compose.prod.yml consome em,,
infra/build-images.sh,9,comment,,"# `${PIPE_VERSAO}`. `latest` sai junto, e só ela: um deploy nunca deve apontar",,
infra/build-images.sh,10,comment,,"# para `latest`, porque então ""voltar a versão anterior"" deixa de ter sentido.",,
infra/build-images.sh,13,identifier,versao,"VERSAO=""${1:?uso: build-images.sh <versao> [app ...]}""",,
infra/build-images.sh,14,identifier,shift,shift || true,,
infra/build-images.sh,23,comment,,# BuildKit explícito: é ele que honra o `apps/<app>/Dockerfile.dockerignore` e o,,
infra/build-images.sh,24,comment,,"# cache de store do pnpm. No builder clássico a build funciona, só fica lenta e",,
infra/build-images.sh,28,comment,,"# Mesmo com a base já em cache, o BuildKit consulta o registro para resolver o",,
infra/build-images.sh,29,comment,,# manifesto do `node:22-alpine` — e para a build inteira se a rede oscilar.,,
infra/build-images.sh,30,comment,,# `SEM_PULL=1` usa o que já está em cache. Não use em CI: lá interessa a base,,
infra/build-images.sh,31,comment,,"# atualizada, com as correções de segurança do alpine.",,
infra/build-images.sh,33,identifier,sem,"[[ ""${SEM_PULL:-0}"" == ""1"" ]] && PULL=(--pull=false)",,
infra/build-images.sh,38,comment,,"# O site é estático e mora no próprio diretório, sem workspace pnpm nenhum.",,
infra/build-images.sh,40,identifier,contexto,"contexto=""apps/site""",,
infra/build-images.sh,42,identifier,contexto,"contexto="".""",,
infra/build-images.sh,53,identifier,versao,"echo ""==> ${REGISTRO}/${app}:${VERSAO}""",,
infra/build-images.sh,56,identifier,versao,"--tag ""${REGISTRO}/${app}:${VERSAO}"" \",,
infra/build-images.sh,61,identifier,contexto,"""$contexto""",,
infra/build-images.sh,65,identifier,imagem,"echo ""imagem                                          tamanho""",,
infra/build-images.sh,67,identifier,versao,"docker image ls ""${REGISTRO}/${app}:${VERSAO}"" --format '{{.Repository}}:{{.Tag}}|{{.Size}}' \",,
infra/build-images.sh,71,comment,,# Tamanho de disco descomprimido. O que trafega no `docker pull` é bem menor —,,
infra/build-images.sh,72,comment,,"# a camada base do node:22-alpine, que responde por ~240 MB de cada linha acima,",,
infra/build-images.sh,73,comment,,"# é a MESMA em `api`, `workers`, `desk` e `crm`: baixa uma vez e as quatro a",,
infra/build-images.sh,74,comment,,# compartilham. `management-vite` e `site` não entram nessa conta — a imagem final,,
infra/build-images.sh,75,comment,,"# dos dois é `nginx:1.27-alpine`, bem menor, porque não sobra Node nenhum depois",,
infra/build-images.sh,77,identifier,por,"echo ""(tamanho descomprimido; a camada base node:22-alpine é compartilhada por api/workers/desk/crm — management-vite e ",,
infra/build-images.sh,77,identifier,sao,"echo ""(tamanho descomprimido; a camada base node:22-alpine é compartilhada por api/workers/desk/crm — management-vite e ",,
infra/build-images.sh,81,identifier,versao,"docker push ""${REGISTRO}/${app}:${VERSAO}""",,
infra/compose/backup/backup.sh,2,comment,,# Backup diário do Postgres. Disparado pelo timer pipe-backup.timer.,,
infra/compose/backup/backup.sh,5,comment,,# centenas de GB gasta banda e janela sem comprar nada — o WAL contínuo é quem,,
infra/compose/backup/backup.sh,6,comment,,"# garante o RPO, o full só encurta o tempo de restauração.",,
infra/compose/backup/backup.sh,16,comment,,# O expire aplica a retenção declarada no pgbackrest.conf. Roda mesmo se o backup,,
infra/compose/backup/backup.sh,17,comment,,# falhou: bucket cheio é o segundo jeito mais comum de perder backup.,,
infra/compose/backup/backup.sh,20,comment,,# `verify` confere soma de verificação de backup e WAL no repositório. NÃO,,
infra/compose/backup/backup.sh,21,comment,,# substitui restaurar — é a checagem barata que roda todo dia; a cara roda semanal.,,
infra/compose/backup/backup.sh,24,identifier,duracao,DURACAO=$(( $(date +%s) - INICIO )),,
infra/compose/backup/backup.sh,26,comment,,"# Métrica em arquivo, lida pelo node-exporter/Prometheus. Um backup que falha em",,
infra/compose/backup/backup.sh,27,comment,,# silêncio é indistinguível de um backup que nunca existiu.,,
infra/compose/backup/backup.sh,28,identifier,metrica,cat > /metricas/pipe_backup.prom.tmp <<METRICA,,
infra/compose/backup/backup.sh,28,identifier,metricas,cat > /metricas/pipe_backup.prom.tmp <<METRICA,,
infra/compose/backup/backup.sh,29,comment,,# HELP pipe_backup_ok 1 quando o último backup terminou sem erro.,,
infra/compose/backup/backup.sh,32,comment,,# HELP pipe_backup_fim_timestamp Momento do fim do último backup.,,
infra/compose/backup/backup.sh,35,comment,,# HELP pipe_backup_duracao_segundos Duração do último backup.,,
infra/compose/backup/backup.sh,37,identifier,duracao,pipe_backup_duracao_segundos ${DURACAO},,
infra/compose/backup/backup.sh,38,identifier,metrica,METRICA,,
infra/compose/backup/backup.sh,39,identifier,metricas,mv /metricas/pipe_backup.prom.tmp /metricas/pipe_backup.prom,,
infra/compose/backup/backup.sh,41,comment,,"# Interruptor de homem morto, num serviço externo gratuito: se a VPS inteira",,
infra/compose/backup/backup.sh,42,comment,,"# morrer, o Prometheus morre junto e não alerta ninguém. Quem alerta é o serviço",,
infra/compose/backup/restore-test.sh,2,comment,,"# Teste semanal de restauração. Backup que nunca foi restaurado é fé, não backup.",,
infra/compose/backup/restore-test.sh,4,comment,,"# O que ele faz: restaura o último backup num diretório descartável, sobe um",,
infra/compose/backup/restore-test.sh,5,comment,,"# Postgres temporário em cima dele, roda consultas que só passam se o dado estiver",,
infra/compose/backup/restore-test.sh,6,comment,,"# lá de verdade, mede quanto tempo levou e publica isso como métrica. O número",,
infra/compose/backup/restore-test.sh,7,comment,,# medido aqui é o RTO real — o do documento é promessa até este script confirmar.,,
infra/compose/backup/restore-test.sh,10,identifier,restauracao,ALVO=/tmp/restauracao-teste,,
infra/compose/backup/restore-test.sh,10,identifier,teste,ALVO=/tmp/restauracao-teste,,
infra/compose/backup/restore-test.sh,11,identifier,porta,PORTA=5499,,
infra/compose/backup/restore-test.sh,24,comment,,# --delta não vale aqui: o diretório está vazio e queremos exercitar a cópia,,
infra/compose/backup/restore-test.sh,25,comment,,"# inteira, que é o que aconteceria num desastre de verdade.",,
infra/compose/backup/restore-test.sh,28,comment,,# `archive_mode=off` no clone: sem isso o Postgres temporário começa a empurrar,,
infra/compose/backup/restore-test.sh,29,comment,,# WAL para o repositório de produção e contamina a linha do tempo.,,
infra/compose/backup/restore-test.sh,30,identifier,porta,"pg_ctl -D ""${ALVO}"" -o ""-p ${PORTA} -c archive_mode=off -c unix_socket_directories=${ALVO}"" -w -t 300 start",,
infra/compose/backup/restore-test.sh,32,comment,,"# As três perguntas que separam ""o processo terminou"" de ""o dado está lá"".",,
infra/compose/backup/restore-test.sh,33,comment,,# 1) as tabelas existem; 2) há atendimento gravado; 3) o dado mais novo é recente,,
infra/compose/backup/restore-test.sh,34,comment,,#    — um backup que restaura dados de três semanas atrás passou nas duas,,
infra/compose/backup/restore-test.sh,35,comment,,#    primeiras e ainda assim é um desastre.,,
infra/compose/backup/restore-test.sh,36,identifier,atendimento,"LINHAS=$(psql -h ""${ALVO}"" -p ""${PORTA}"" -U pipe -d pipe -tAc ""select count(*) from atendimento"")",,
infra/compose/backup/restore-test.sh,36,identifier,porta,"LINHAS=$(psql -h ""${ALVO}"" -p ""${PORTA}"" -U pipe -d pipe -tAc ""select count(*) from atendimento"")",,
infra/compose/backup/restore-test.sh,37,identifier,idade,"IDADE=$(psql -h ""${ALVO}"" -p ""${PORTA}"" -U pipe -d pipe -tAc \",,
infra/compose/backup/restore-test.sh,37,identifier,porta,"IDADE=$(psql -h ""${ALVO}"" -p ""${PORTA}"" -U pipe -d pipe -tAc \",,
infra/compose/backup/restore-test.sh,38,identifier,mensagem,"""select extract(epoch from now() - max(criada_em))::int from mensagem"")",,
infra/compose/backup/restore-test.sh,40,identifier,idade,"if [ ""${LINHAS}"" -gt 0 ] && [ ""${IDADE}"" -lt 86400 ]; then",,
infra/compose/backup/restore-test.sh,44,identifier,duracao,DURACAO=$(( $(date +%s) - INICIO )),,
infra/compose/backup/restore-test.sh,46,identifier,metrica,cat > /metricas/pipe_restauracao.prom.tmp <<METRICA,,
infra/compose/backup/restore-test.sh,46,identifier,metricas,cat > /metricas/pipe_restauracao.prom.tmp <<METRICA,,
infra/compose/backup/restore-test.sh,46,identifier,restauracao,cat > /metricas/pipe_restauracao.prom.tmp <<METRICA,,
infra/compose/backup/restore-test.sh,47,comment,,# HELP pipe_restauracao_ok 1 quando o último teste de restauração validou o dado.,,
infra/compose/backup/restore-test.sh,49,identifier,restauracao,pipe_restauracao_ok ${OK},,
infra/compose/backup/restore-test.sh,52,identifier,duracao,pipe_restauracao_segundos ${DURACAO},,
infra/compose/backup/restore-test.sh,52,identifier,restauracao,pipe_restauracao_segundos ${DURACAO},,
infra/compose/backup/restore-test.sh,53,comment,,# HELP pipe_restauracao_fim_timestamp Momento do último teste.,,
infra/compose/backup/restore-test.sh,55,identifier,restauracao,pipe_restauracao_fim_timestamp $(date +%s),,
infra/compose/backup/restore-test.sh,58,identifier,idade,pipe_restauracao_atraso_dado_segundos ${IDADE},,
infra/compose/backup/restore-test.sh,58,identifier,restauracao,pipe_restauracao_atraso_dado_segundos ${IDADE},,
infra/compose/backup/restore-test.sh,59,identifier,metrica,METRICA,,
infra/compose/backup/restore-test.sh,60,identifier,metricas,mv /metricas/pipe_restauracao.prom.tmp /metricas/pipe_restauracao.prom,,
infra/compose/backup/restore-test.sh,60,identifier,restauracao,mv /metricas/pipe_restauracao.prom.tmp /metricas/pipe_restauracao.prom,,
infra/compose/backup/restore-test.sh,62,identifier,restauracao,"if [ -n ""${HEALTHCHECK_URL_RESTAURACAO:-}"" ] && [ ""${OK}"" -eq 1 ]; then",,
infra/compose/backup/restore-test.sh,63,identifier,restauracao,"curl -fsS -m 10 --retry 3 ""${HEALTHCHECK_URL_RESTAURACAO}"" > /dev/null || true",C,D-06/D-36
infra/compose/bootstrap.sh,2,comment,,"# Primeira implantação do Pipe numa VPS limpa. Roda na máquina, como root, a",,
infra/compose/bootstrap.sh,7,comment,,"# O que ele faz: tudo que é automatizável, na ordem em que precisa acontecer.",,
infra/compose/bootstrap.sh,8,comment,,"# O que ele NÃO faz: comprar domínio, apontar DNS, criar aplicativo no Google, criar",,
infra/compose/bootstrap.sh,9,comment,,"# aplicativo na Meta, gerar chave de cifra. Nesses ele PARA e diz exatamente o que",,
infra/compose/bootstrap.sh,10,comment,,"# falta — de propósito. Script que ""dá um jeito"" no que é decisão do dono é como se",,
infra/compose/bootstrap.sh,11,comment,,# sobe produção com segredo de exemplo.,,
infra/compose/bootstrap.sh,13,comment,,# É idempotente: rodar de novo depois de corrigir alguma coisa retoma de onde dá.,,
