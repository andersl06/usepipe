infra/compose/docker-compose.prod.yml,176,identifier,dominio,- traefik.http.routers.desk.rule=HostRegexp(`^[a-z0-9-]+\.desk\.${PIPE_DOMINIO_CONTAS}$`),C,D-06/D-36
infra/compose/docker-compose.prod.yml,181,comment,,"# Gestão como SPA estática (Vite + nginx): não fala com o Postgres, não lê",,
infra/compose/docker-compose.prod.yml,182,comment,,"# `.env`, não tem `PIPE_URL_ESTE_APP` — a origem do próprio app já sai",,
infra/compose/docker-compose.prod.yml,183,comment,,"# embutida no bundle (`VITE_URL_API`, assado por `build-images.sh`), e",,
infra/compose/docker-compose.prod.yml,184,comment,,"# quem decide ""para onde volto depois do login"" é o navegador",,
infra/compose/docker-compose.prod.yml,185,comment,,"# (`window.location.origin`), não uma variável de servidor. Por isso está só",,
infra/compose/docker-compose.prod.yml,186,comment,,"# na rede `borda`, como o `site`, e não em `dados`.",,
