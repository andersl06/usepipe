infra/compose/docker-compose.prod.yml,270,comment,,# Imagem própria só para ter o pgbackrest ao lado do Postgres: o,,
infra/compose/docker-compose.prod.yml,271,comment,,"# archive_command roda DENTRO deste contêiner, então o binário precisa estar",,
infra/compose/docker-compose.prod.yml,272,comment,,# aqui — não adianta deixá-lo só no contêiner de backup.,,
infra/compose/docker-compose.prod.yml,278,identifier,senha,POSTGRES_PASSWORD: ${POSTGRES_SENHA},C,D-06/D-36
infra/compose/docker-compose.prod.yml,280,identifier,sao,TZ: America/Sao_Paulo,,
infra/compose/docker-compose.prod.yml,281,comment,,"# Lida pelo script de inicialização abaixo. É a senha do papel `pipe_app`,",,
infra/compose/docker-compose.prod.yml,282,comment,,# e precisa bater com a de DATABASE_URL_APP.,,
infra/compose/docker-compose.prod.yml,283,identifier,senha,POSTGRES_APP_SENHA: ${POSTGRES_APP_SENHA},,
infra/compose/docker-compose.prod.yml,284,comment,,# O `archive_command` roda DENTRO deste contêiner e fala com o bucket: sem,,
infra/compose/docker-compose.prod.yml,285,comment,,"# estas três o archive-push falha em silêncio a cada segmento de WAL, o",,
infra/compose/docker-compose.prod.yml,286,comment,,# Postgres passa a acumular `pg_wal` e o disco acaba. Estavam só no serviço,,
infra/compose/docker-compose.prod.yml,287,comment,,"# de backup, que não é quem arquiva.",,
infra/compose/docker-compose.prod.yml,289,identifier,segredo,PGBACKREST_REPO1_S3_KEY_SECRET: ${BACKUP_S3_SEGREDO},C,D-06/D-36
infra/compose/docker-compose.prod.yml,294,comment,,"# `off` no primeiro `up`, de propósito. Arquivar antes de a stanza existir",,
infra/compose/docker-compose.prod.yml,295,comment,,"# é o mesmo que não arquivar, só que enchendo o disco: o `archive_command`",,
infra/compose/docker-compose.prod.yml,297,comment,,# implantação manda rodar `pgbackrest stanza-create` e SÓ ENTÃO trocar esta,,
infra/compose/docker-compose.prod.yml,298,comment,,# variável para `on` e reiniciar o banco.,,
infra/compose/docker-compose.prod.yml,302,comment,,# WAL fechado a cada 60s: é isto que torna verdadeira a promessa de RPO de 5,,
infra/compose/docker-compose.prod.yml,303,comment,,"# minutos num banco parado de madrugada, quando o WAL demoraria horas a encher.",,
infra/compose/docker-compose.prod.yml,312,comment,,# O papel `pipe_app` NÃO nasce das migrations: todo `grant` para ele em,,
infra/compose/docker-compose.prod.yml,313,comment,,# packages/db/drizzle vem embrulhado em `IF EXISTS (... pg_roles ...)` e é,,
infra/compose/docker-compose.prod.yml,314,comment,,# pulado em silêncio se o papel não existir. Em desenvolvimento quem o cria,,
infra/compose/docker-compose.prod.yml,315,comment,,"# é docker/postgres/init.sql, que este compose nunca montou — e o resultado",,
infra/compose/docker-compose.prod.yml,316,comment,,# era API e fronts sem conseguir conectar com DATABASE_URL_APP.,,
infra/compose/docker-compose.prod.yml,317,comment,,"# O diretório roda uma vez só, na inicialização de um PGDATA vazio, ANTES",,
infra/compose/docker-compose.prod.yml,318,comment,,# do primeiro `migrar` — que é exatamente a ordem que os grants exigem.,,
infra/compose/docker-compose.prod.yml,321,comment,,# O soquete unix é compartilhado com o contêiner de backup: é assim que o,,
infra/compose/docker-compose.prod.yml,322,comment,,# pgBackRest abre e fecha o backup sem que o Postgres precise escutar em TCP,,
infra/compose/docker-compose.prod.yml,323,comment,,# para alguém além da rede `dados`.,,
infra/compose/docker-compose.prod.yml,325,comment,,# Nenhuma porta publicada. Para depurar: `docker compose exec postgres psql`,,
infra/compose/docker-compose.prod.yml,326,comment,,# ou um túnel SSH — não um mapeamento que fica aberto para sempre.,,
infra/compose/docker-compose.prod.yml,327,identifier,dados,networks: [dados],,
infra/compose/docker-compose.prod.yml,334,identifier,cmd,"test: ['CMD-SHELL', 'pg_isready -U pipe -d pipe']",,
