infra/.sops.yaml,1,comment,,# Regras do SOPS. Rode `sops` a partir de `infra/` para que este arquivo valha.,,
infra/.sops.yaml,3,comment,,"# age em vez de GPG: chave de 60 caracteres, sem chaveiro, sem agente, sem data de",,
infra/.sops.yaml,4,comment,,# validade que expira no feriado. O segredo cifrado é versionado no repositório e,,
infra/.sops.yaml,5,comment,,"# o diff continua legível — muda uma linha, aparece uma linha.",,
infra/.sops.yaml,7,comment,,"# Duas destinatárias em toda regra, sempre:",,
infra/.sops.yaml,8,comment,,"#  - a do operador, que fica na máquina dele e numa cópia offline;",,
infra/.sops.yaml,9,comment,,"#  - a de deploy, que fica na VPS em /opt/pipe-dados/age.key e SÓ decifra.",,
infra/.sops.yaml,10,comment,,# Uma só significa que perder o notebook é perder produção.,,
infra/.sops.yaml,12,comment,,# Rotacionar destinatária: edite as chaves abaixo e rode,,
infra/.sops.yaml,14,comment,,# O conteúdo não muda; muda quem consegue abrir.,,
infra/.sops.yaml,17,identifier,producao,- path_regex: compose/segredos/producao.*\.enc\.env$,,
infra/.sops.yaml,17,identifier,segredos,- path_regex: compose/segredos/producao.*\.enc\.env$,,
infra/.sops.yaml,22,identifier,homologacao,- path_regex: compose/segredos/homologacao.*\.enc\.env$,,
infra/.sops.yaml,22,identifier,segredos,- path_regex: compose/segredos/homologacao.*\.enc\.env$,,
infra/.sops.yaml,27,comment,,"# Segredos do cluster: o kustomize-controller do Flux decifra sozinho, com a",,
infra/.sops.yaml,28,comment,,# chave guardada como Secret no cluster. Não é preciso outro operador para isso.,,
infra/compose/backup/backup.sh,2,comment,,# Backup diário do Postgres. Disparado pelo timer pipe-backup.timer.,,
infra/compose/backup/backup.sh,5,comment,,# centenas de GB gasta banda e janela sem comprar nada — o WAL contínuo é quem,,
infra/compose/backup/backup.sh,6,comment,,"# garante o RPO, o full só encurta o tempo de restauração.",,
infra/compose/backup/backup.sh,16,comment,,# O expire aplica a retenção declarada no pgbackrest.conf. Roda mesmo se o backup,,
infra/compose/backup/backup.sh,17,comment,,# falhou: bucket cheio é o segundo jeito mais comum de perder backup.,,
infra/compose/backup/backup.sh,20,comment,,# `verify` confere soma de verificação de backup e WAL no repositório. NÃO,,
infra/compose/backup/backup.sh,21,comment,,# substitui restaurar — é a checagem barata que roda todo dia; a cara roda semanal.,,
infra/compose/backup/backup.sh,24,identifier,duracao,DURACAO=$(( $(date +%s) - INICIO )),,
infra/compose/backup/backup.sh,26,comment,,"# Métrica em arquivo, lida pelo node-exporter/Prometheus. Um backup que falha em",,
infra/compose/backup/backup.sh,27,comment,,# silêncio é indistinguível de um backup que nunca existiu.,,
infra/compose/backup/backup.sh,28,identifier,metrica,cat > /metricas/pipe_backup.prom.tmp <<METRICA,,
infra/compose/backup/backup.sh,28,identifier,metricas,cat > /metricas/pipe_backup.prom.tmp <<METRICA,,
infra/compose/backup/backup.sh,29,comment,,# HELP pipe_backup_ok 1 quando o último backup terminou sem erro.,,
infra/compose/backup/backup.sh,32,comment,,# HELP pipe_backup_fim_timestamp Momento do fim do último backup.,,
infra/compose/backup/backup.sh,35,comment,,# HELP pipe_backup_duracao_segundos Duração do último backup.,,
infra/compose/backup/backup.sh,37,identifier,duracao,pipe_backup_duracao_segundos ${DURACAO},,
infra/compose/backup/backup.sh,38,identifier,metrica,METRICA,,
infra/compose/backup/backup.sh,39,identifier,metricas,mv /metricas/pipe_backup.prom.tmp /metricas/pipe_backup.prom,,
infra/compose/backup/backup.sh,41,comment,,"# Interruptor de homem morto, num serviço externo gratuito: se a VPS inteira",,
infra/compose/backup/backup.sh,42,comment,,"# morrer, o Prometheus morre junto e não alerta ninguém. Quem alerta é o serviço",,
infra/compose/backup/restaurar-teste.sh,1,path,restaurar,infra/compose/backup/restaurar-teste.sh,,
infra/compose/backup/restaurar-teste.sh,1,path,teste,infra/compose/backup/restaurar-teste.sh,,
infra/compose/backup/restaurar-teste.sh,2,comment,,"# Teste semanal de restauração. Backup que nunca foi restaurado é fé, não backup.",,
infra/compose/backup/restaurar-teste.sh,4,comment,,"# O que ele faz: restaura o último backup num diretório descartável, sobe um",,
infra/compose/backup/restaurar-teste.sh,5,comment,,"# Postgres temporário em cima dele, roda consultas que só passam se o dado estiver",,
infra/compose/backup/restaurar-teste.sh,6,comment,,"# lá de verdade, mede quanto tempo levou e publica isso como métrica. O número",,
infra/compose/backup/restaurar-teste.sh,7,comment,,# medido aqui é o RTO real — o do documento é promessa até este script confirmar.,,
infra/compose/backup/restaurar-teste.sh,10,identifier,restauracao,ALVO=/tmp/restauracao-teste,,
infra/compose/backup/restaurar-teste.sh,10,identifier,teste,ALVO=/tmp/restauracao-teste,,
infra/compose/backup/restaurar-teste.sh,11,identifier,porta,PORTA=5499,,
infra/compose/backup/restaurar-teste.sh,24,comment,,# --delta não vale aqui: o diretório está vazio e queremos exercitar a cópia,,
infra/compose/backup/restaurar-teste.sh,25,comment,,"# inteira, que é o que aconteceria num desastre de verdade.",,
infra/compose/backup/restaurar-teste.sh,28,comment,,# `archive_mode=off` no clone: sem isso o Postgres temporário começa a empurrar,,
infra/compose/backup/restaurar-teste.sh,29,comment,,# WAL para o repositório de produção e contamina a linha do tempo.,,
infra/compose/backup/restaurar-teste.sh,30,identifier,porta,"pg_ctl -D ""${ALVO}"" -o ""-p ${PORTA} -c archive_mode=off -c unix_socket_directories=${ALVO}"" -w -t 300 start",,
infra/compose/backup/restaurar-teste.sh,32,comment,,"# As três perguntas que separam ""o processo terminou"" de ""o dado está lá"".",,
infra/compose/backup/restaurar-teste.sh,33,comment,,# 1) as tabelas existem; 2) há atendimento gravado; 3) o dado mais novo é recente,,
infra/compose/backup/restaurar-teste.sh,34,comment,,#    — um backup que restaura dados de três semanas atrás passou nas duas,,
infra/compose/backup/restaurar-teste.sh,35,comment,,#    primeiras e ainda assim é um desastre.,,
infra/compose/backup/restaurar-teste.sh,36,identifier,atendimento,"LINHAS=$(psql -h ""${ALVO}"" -p ""${PORTA}"" -U pipe -d pipe -tAc ""select count(*) from atendimento"")",,
infra/compose/backup/restaurar-teste.sh,36,identifier,porta,"LINHAS=$(psql -h ""${ALVO}"" -p ""${PORTA}"" -U pipe -d pipe -tAc ""select count(*) from atendimento"")",,
infra/compose/backup/restaurar-teste.sh,37,identifier,idade,"IDADE=$(psql -h ""${ALVO}"" -p ""${PORTA}"" -U pipe -d pipe -tAc \",,
infra/compose/backup/restaurar-teste.sh,37,identifier,porta,"IDADE=$(psql -h ""${ALVO}"" -p ""${PORTA}"" -U pipe -d pipe -tAc \",,
infra/compose/backup/restaurar-teste.sh,38,identifier,mensagem,"""select extract(epoch from now() - max(criada_em))::int from mensagem"")",,
infra/compose/backup/restaurar-teste.sh,40,identifier,idade,"if [ ""${LINHAS}"" -gt 0 ] && [ ""${IDADE}"" -lt 86400 ]; then",,
infra/compose/backup/restaurar-teste.sh,44,identifier,duracao,DURACAO=$(( $(date +%s) - INICIO )),,
infra/compose/backup/restaurar-teste.sh,46,identifier,metrica,cat > /metricas/pipe_restauracao.prom.tmp <<METRICA,,
infra/compose/backup/restaurar-teste.sh,46,identifier,metricas,cat > /metricas/pipe_restauracao.prom.tmp <<METRICA,,
infra/compose/backup/restaurar-teste.sh,46,identifier,restauracao,cat > /metricas/pipe_restauracao.prom.tmp <<METRICA,,
infra/compose/backup/restaurar-teste.sh,47,comment,,# HELP pipe_restauracao_ok 1 quando o último teste de restauração validou o dado.,,
infra/compose/backup/restaurar-teste.sh,49,identifier,restauracao,pipe_restauracao_ok ${OK},,
infra/compose/backup/restaurar-teste.sh,52,identifier,duracao,pipe_restauracao_segundos ${DURACAO},,
infra/compose/backup/restaurar-teste.sh,52,identifier,restauracao,pipe_restauracao_segundos ${DURACAO},,
infra/compose/backup/restaurar-teste.sh,53,comment,,# HELP pipe_restauracao_fim_timestamp Momento do último teste.,,
infra/compose/backup/restaurar-teste.sh,55,identifier,restauracao,pipe_restauracao_fim_timestamp $(date +%s),,
infra/compose/backup/restaurar-teste.sh,58,identifier,idade,pipe_restauracao_atraso_dado_segundos ${IDADE},,
infra/compose/backup/restaurar-teste.sh,58,identifier,restauracao,pipe_restauracao_atraso_dado_segundos ${IDADE},,
infra/compose/backup/restaurar-teste.sh,59,identifier,metrica,METRICA,,
infra/compose/backup/restaurar-teste.sh,60,identifier,metricas,mv /metricas/pipe_restauracao.prom.tmp /metricas/pipe_restauracao.prom,,
infra/compose/backup/restaurar-teste.sh,60,identifier,restauracao,mv /metricas/pipe_restauracao.prom.tmp /metricas/pipe_restauracao.prom,,
infra/compose/backup/restaurar-teste.sh,62,identifier,restauracao,"if [ -n ""${HEALTHCHECK_URL_RESTAURACAO:-}"" ] && [ ""${OK}"" -eq 1 ]; then",,
infra/compose/backup/restaurar-teste.sh,63,identifier,restauracao,"curl -fsS -m 10 --retry 3 ""${HEALTHCHECK_URL_RESTAURACAO}"" > /dev/null || true",C,D-06/D-36
infra/compose/deploy.sh,2,comment,,"# Publicação de uma versão nova. Roda na VPS, como root, a partir de /opt/pipe.",,
infra/compose/deploy.sh,4,comment,,"# Este script é para a SEGUNDA publicação em diante. A primeira, do zero, é",,
infra/compose/deploy.sh,5,comment,,"# `implantar.sh` — ela tem passos que só acontecem uma vez (papel do banco,",,
infra/compose/deploy.sh,6,comment,,"# stanza do backup, tenant, canal) e paradas para o que só o dono pode fazer.",,
infra/compose/deploy.sh,8,comment,,"# A ordem não é gosto: migration antes do código novo (§9 da spec), porque só",,
infra/compose/deploy.sh,9,comment,,# assim dá para voltar a versão anterior sem perder dado. Toda migration precisa,,
infra/compose/deploy.sh,10,comment,,"# ser compatível com o código antigo — este script não tem como verificar isso, e",,
infra/compose/deploy.sh,11,comment,,# é a única regra aqui que depende de disciplina humana.,,
infra/compose/deploy.sh,14,identifier,imagem,"VERSAO=""${1:?uso: deploy.sh <tag da imagem>}""",,
infra/compose/deploy.sh,14,identifier,versao,"VERSAO=""${1:?uso: deploy.sh <tag da imagem>}""",,
infra/compose/deploy.sh,17,comment,,# Segredo nunca fica em disco versionado. O arquivo cifrado vive no repositório;,,
infra/compose/deploy.sh,18,comment,,"# a chave age vive só na máquina, com dono root e modo 600.",,
infra/compose/deploy.sh,19,identifier,dados,export SOPS_AGE_KEY_FILE=/opt/pipe-dados/age.key,,
infra/compose/deploy.sh,21,identifier,dados,sops --decrypt segredos/producao.enc.env > /opt/pipe-dados/.env,,
infra/compose/deploy.sh,21,identifier,producao,sops --decrypt segredos/producao.enc.env > /opt/pipe-dados/.env,,
infra/compose/deploy.sh,21,identifier,segredos,sops --decrypt segredos/producao.enc.env > /opt/pipe-dados/.env,,
infra/compose/deploy.sh,22,comment,,"# Depois do arquivo cifrado, de propósito: em `--env-file` vale a última",,
infra/compose/deploy.sh,23,comment,,"# definição, então esta linha sobrescreve o PIPE_VERSAO que veio do SOPS.",,
infra/compose/deploy.sh,24,identifier,dados,"echo ""PIPE_VERSAO=${VERSAO}"" >> /opt/pipe-dados/.env",,
infra/compose/deploy.sh,24,identifier,versao,"echo ""PIPE_VERSAO=${VERSAO}"" >> /opt/pipe-dados/.env",C,D-06/D-36
infra/compose/deploy.sh,26,identifier,dados,"COMPOSE=""docker compose -f docker-compose.prod.yml --env-file /opt/pipe-dados/.env""",,
infra/compose/deploy.sh,28,comment,,"# `postgres` e `backup` são construídos aqui, não puxados: a imagem é o Postgres",,
infra/compose/deploy.sh,29,comment,,"# com pgbackrest ao lado, e ela não está em registro nenhum. `--ignore-buildable`",,
infra/compose/deploy.sh,30,comment,,# impede que o `pull` pare a publicação tentando baixar justamente essas duas.,,
infra/compose/deploy.sh,34,identifier,migrar,$COMPOSE --profile tarefa run --rm migrar,,
infra/compose/deploy.sh,37,comment,,"# sem ele, ""deploy ok"" significa apenas ""o contêiner iniciou"", que é diferente de",,
infra/compose/deploy.sh,38,comment,,"# ""o contêiner responde"".",,
infra/compose/deploy.sh,41,comment,,# Registro de publicação que o suporte consiga consultar às duas da manhã.,,
infra/compose/deploy.sh,42,identifier,dados,"printf '%s\t%s\t%s\n' ""$(date -Is)"" ""${VERSAO}"" ""${SUDO_USER:-root}"" >> /opt/pipe-dados/publicacoes.tsv",,
infra/compose/deploy.sh,42,identifier,publicacoes,"printf '%s\t%s\t%s\n' ""$(date -Is)"" ""${VERSAO}"" ""${SUDO_USER:-root}"" >> /opt/pipe-dados/publicacoes.tsv",,
infra/compose/deploy.sh,42,identifier,versao,"printf '%s\t%s\t%s\n' ""$(date -Is)"" ""${VERSAO}"" ""${SUDO_USER:-root}"" >> /opt/pipe-dados/publicacoes.tsv",,
infra/compose/docker-compose.prod.yml,1,comment,,# Pipe em produção numa máquina só — o degrau pequeno.,,
infra/compose/docker-compose.prod.yml,3,comment,,"# Diferenças em relação ao docker-compose.yml da raiz, que é de desenvolvimento:",,
infra/compose/docker-compose.prod.yml,5,comment,,"# de CPU e memória por serviço, healthcheck em tudo que recebe tráfego, e o",,
infra/compose/docker-compose.prod.yml,6,comment,,# backup como serviço de verdade.,,
infra/compose/docker-compose.prod.yml,9,comment,,# O .env é gerado pelo deploy.sh a partir do arquivo SOPS; nunca é versionado.,,
infra/compose/docker-compose.prod.yml,13,identifier,padrao,x-padrao: &padrao,,
infra/compose/docker-compose.prod.yml,15,comment,,# Log sem rotação enche o disco da VPS em semanas e derruba o Postgres junto.,,
infra/compose/docker-compose.prod.yml,23,identifier,padrao,<<: *padrao,,
infra/compose/docker-compose.prod.yml,24,identifier,dados,env_file: [/opt/pipe-dados/.env],,
infra/compose/docker-compose.prod.yml,25,identifier,dados,"networks: [borda, dados]",,
infra/compose/docker-compose.prod.yml,26,comment,,# Tetos calculados para uma VPS de 4 vCPU / 16 GB. A soma dos limites passa do,,
infra/compose/docker-compose.prod.yml,27,comment,,# total de propósito: nem todos chegam no teto ao mesmo tempo. O que não pode,,
infra/compose/docker-compose.prod.yml,28,comment,,"# faltar é o teto — sem ele, um vazamento no worker mata o Postgres junto.",,
infra/compose/docker-compose.prod.yml,39,comment,,"# O HEALTHCHECK das duas imagens Next que restam (`desk`, `crm`) sai com",,
infra/compose/docker-compose.prod.yml,41,comment,,"# ""healthy"" para sempre. Aqui a raiz é aceita só abaixo de 500. Não é `/saude`",,
infra/compose/docker-compose.prod.yml,42,comment,,"# — Next não tem uma —, mas já separa ""o processo subiu"" de ""o processo",,
infra/compose/docker-compose.prod.yml,43,comment,,"# consegue renderizar"". `gestao-vite` não usa isto: é estático, sem banco para",,
infra/compose/docker-compose.prod.yml,44,comment,,"# falhar, e o HEALTHCHECK da própria imagem (`apps/gestao-vite/Dockerfile`) já",,
infra/compose/docker-compose.prod.yml,49,identifier,cmd,"'CMD',",,
infra/compose/docker-compose.prod.yml,61,identifier,padrao,<<: *padrao,,
infra/compose/docker-compose.prod.yml,65,comment,,"# Sem isto, todo contêiner novo vira rota publicada por acidente.",,
infra/compose/docker-compose.prod.yml,67,comment,,"# `api`, `desk` e `crm` estão em DUAS redes (`gestao-vite` não: é estático,",,
infra/compose/docker-compose.prod.yml,68,comment,,"# não fala com o Postgres, e vive só na `borda`). Sem esta linha o Traefik",,
infra/compose/docker-compose.prod.yml,69,comment,,# escolhe um dos dois IPs sem critério estável nos que estão em duas — e,,
infra/compose/docker-compose.prod.yml,70,comment,,"# quando escolhe o da rede `dados`, onde ele não está, dá 502 que some e",,
infra/compose/docker-compose.prod.yml,71,comment,,# volta a cada recriação de contêiner. O nome tem o prefixo do projeto,,
infra/compose/docker-compose.prod.yml,78,comment,,"# ACME por desafio HTTP: não exige token de DNS na máquina, e a porta 80 já",,
infra/compose/docker-compose.prod.yml,91,comment,,"# Somente leitura: o Traefik precisa descobrir contêiner, não controlar o",,
infra/compose/docker-compose.prod.yml,92,comment,,# Docker. Socket rw aqui é root na máquina para quem tomar o Traefik.,,
infra/compose/docker-compose.prod.yml,94,identifier,dados,- /opt/pipe-dados/acme:/acme,,
infra/compose/docker-compose.prod.yml,102,identifier,cmd,"test: ['CMD', 'traefik', 'healthcheck', '--ping']",,
infra/compose/docker-compose.prod.yml,109,comment,,# Construída por infra/construir-imagens.sh a partir de apps/api/Dockerfile.,,
infra/compose/docker-compose.prod.yml,110,identifier,versao,image: ghcr.io/pipe/api:${PIPE_VERSAO},C,D-06/D-36
infra/compose/docker-compose.prod.yml,112,comment,,# e devolve 503 quando o pool da aplicação não responde. O HEALTHCHECK da,,
infra/compose/docker-compose.prod.yml,113,comment,,# imagem ainda bate na raiz `/` e aprova qualquer coisa abaixo de 500 — o que,,
infra/compose/docker-compose.prod.yml,114,comment,,"# dá ""healthy"" com o banco fora. Este bloco sobrescreve o da imagem, e é a",,
infra/compose/docker-compose.prod.yml,115,comment,,"# diferença entre ""o contêiner iniciou"" e ""o contêiner atende"".",,
infra/compose/docker-compose.prod.yml,119,identifier,cmd,"'CMD',",,
infra/compose/docker-compose.prod.yml,130,comment,,"# `!PathPrefix('/metrics')`: o roteador é por Host, e sem esta negação",,
infra/compose/docker-compose.prod.yml,131,comment,,# `https://api.usepipe.com.br/metrics` fica público. O porteiro da própria,,
infra/compose/docker-compose.prod.yml,132,comment,,"# rota libera faixa privada quando não há token, e atrás do Traefik o IP",,
infra/compose/docker-compose.prod.yml,133,comment,,"# visto É privado — ou seja, a defesa da aplicação não vale aqui. O",,
infra/compose/docker-compose.prod.yml,135,identifier,com,- traefik.http.routers.api.rule=Host(`api.usepipe.com.br`) && !PathPrefix(`/metrics`),,
infra/compose/docker-compose.prod.yml,147,identifier,versao,image: ghcr.io/pipe/workers:${PIPE_VERSAO},C,D-06/D-36
infra/compose/docker-compose.prod.yml,148,comment,,# Fila de entrega é o que segura a conta na hora cheia; é o primeiro serviço a,,
infra/compose/docker-compose.prod.yml,149,comment,,# ganhar réplica quando a profundidade da fila subir (§7 da spec).,,
infra/compose/docker-compose.prod.yml,165,comment,,# Desk Vite estático: não fala com Postgres nem lê `.env` em execução.,,
infra/compose/docker-compose.prod.yml,166,identifier,padrao,<<: *padrao,,
infra/compose/docker-compose.prod.yml,167,identifier,versao,image: ghcr.io/pipe/desk-vite:${PIPE_VERSAO},C,D-06/D-36
infra/compose/docker-compose.prod.yml,171,identifier,com,- traefik.http.routers.desk.rule=Host(`app.usepipe.com.br`),,
infra/compose/docker-compose.prod.yml,176,comment,,"# Gestão como SPA estática (Vite + nginx): não fala com o Postgres, não lê",,
infra/compose/docker-compose.prod.yml,177,comment,,"# `.env`, não tem `PIPE_URL_ESTE_APP` — a origem do próprio app já sai",,
infra/compose/docker-compose.prod.yml,179,comment,,"# quem decide ""para onde volto depois do login"" é o navegador",,
infra/compose/docker-compose.prod.yml,180,comment,,"# (`window.location.origin`), não uma variável de servidor. Por isso está só",,
infra/compose/docker-compose.prod.yml,181,comment,,"# na rede `borda`, como o `site`, e não em `dados`.",,
infra/compose/docker-compose.prod.yml,182,identifier,gestao,gestao-vite:,,
infra/compose/docker-compose.prod.yml,183,identifier,padrao,<<: *padrao,,
infra/compose/docker-compose.prod.yml,184,identifier,gestao,image: ghcr.io/pipe/gestao-vite:${PIPE_VERSAO},,
infra/compose/docker-compose.prod.yml,184,identifier,versao,image: ghcr.io/pipe/gestao-vite:${PIPE_VERSAO},C,D-06/D-36
infra/compose/docker-compose.prod.yml,193,identifier,com,- traefik.http.routers.gestao.rule=Host(`gestao.usepipe.com.br`),,
infra/compose/docker-compose.prod.yml,193,identifier,gestao,- traefik.http.routers.gestao.rule=Host(`gestao.usepipe.com.br`),,
infra/compose/docker-compose.prod.yml,194,identifier,gestao,- traefik.http.routers.gestao.entrypoints=websec,,
infra/compose/docker-compose.prod.yml,195,identifier,gestao,- traefik.http.routers.gestao.tls.certresolver=le,,
infra/compose/docker-compose.prod.yml,196,identifier,gestao,- traefik.http.services.gestao.loadbalancer.server.port=80,,
infra/compose/docker-compose.prod.yml,198,comment,,"# O CRM que existe HOJE é `apps/crm`, Next 15, código nosso, dentro do monorepo —",,
infra/compose/docker-compose.prod.yml,199,comment,,"# e é ele que esta imagem empacota (infra/construir-imagens.sh, apps/crm/Dockerfile).",,
infra/compose/docker-compose.prod.yml,201,comment,,# O fork AGPLv3 do Twenty (docs/specs/2026-09-07-fork-do-twenty.md) ainda não tem,,
infra/compose/docker-compose.prod.yml,202,comment,,"# imagem publicada. Quando tiver, esta linha vira",,
infra/compose/docker-compose.prod.yml,203,comment,,# `image: ghcr.io/pipe/crm-fork:${PIPE_CRM_VERSAO}` e nada mais muda: a fronteira,,
infra/compose/docker-compose.prod.yml,204,comment,,"# de licença é justamente esta — serviço separado, imagem separada, conversa por",,
infra/compose/docker-compose.prod.yml,207,identifier,padrao,<<: *padrao,,
infra/compose/docker-compose.prod.yml,208,identifier,versao,image: ghcr.io/pipe/crm:${PIPE_VERSAO},C,D-06/D-36
infra/compose/docker-compose.prod.yml,209,comment,,"# Um `.env` só, e não um `.env.crm` à parte: `apps/crm` é código nosso, lê o",,
infra/compose/docker-compose.prod.yml,211,comment,,# `PIPE_CHAVES_SEGREDO`) e um segundo arquivo cifrado era mais uma coisa para,,
infra/compose/docker-compose.prod.yml,213,comment,,"# ganha o arquivo próprio — aí a separação existe por licença, não por hábito.",,
infra/compose/docker-compose.prod.yml,214,identifier,dados,env_file: [/opt/pipe-dados/.env],,
infra/compose/docker-compose.prod.yml,215,identifier,dados,"networks: [borda, dados]",,
infra/compose/docker-compose.prod.yml,217,identifier,com,PIPE_URL_ESTE_APP: https://crm.usepipe.com.br,,
infra/compose/docker-compose.prod.yml,217,identifier,este,PIPE_URL_ESTE_APP: https://crm.usepipe.com.br,,
infra/compose/docker-compose.prod.yml,229,identifier,com,- traefik.http.routers.crm.rule=Host(`crm.usepipe.com.br`),,
infra/compose/docker-compose.prod.yml,235,identifier,padrao,<<: *padrao,,
infra/compose/docker-compose.prod.yml,236,identifier,versao,image: ghcr.io/pipe/site:${PIPE_VERSAO},C,D-06/D-36
infra/compose/docker-compose.prod.yml,245,identifier,com,- traefik.http.routers.site.rule=Host(`usepipe.com.br`) || Host(`www.usepipe.com.br`),,
infra/compose/docker-compose.prod.yml,251,identifier,padrao,<<: *padrao,,
infra/compose/docker-compose.prod.yml,252,comment,,# Imagem própria só para ter o pgbackrest ao lado do Postgres: o,,
infra/compose/docker-compose.prod.yml,253,comment,,"# archive_command roda DENTRO deste contêiner, então o binário precisa estar",,
infra/compose/docker-compose.prod.yml,254,comment,,# aqui — não adianta deixá-lo só no contêiner de backup.,,
infra/compose/docker-compose.prod.yml,260,identifier,senha,POSTGRES_PASSWORD: ${POSTGRES_SENHA},C,D-06/D-36
infra/compose/docker-compose.prod.yml,262,identifier,sao,TZ: America/Sao_Paulo,,
infra/compose/docker-compose.prod.yml,263,comment,,"# Lida pelo script de inicialização abaixo. É a senha do papel `pipe_app`,",,
infra/compose/docker-compose.prod.yml,264,comment,,# e precisa bater com a de DATABASE_URL_APP.,,
infra/compose/docker-compose.prod.yml,265,identifier,senha,POSTGRES_APP_SENHA: ${POSTGRES_APP_SENHA},,
infra/compose/docker-compose.prod.yml,266,comment,,# O `archive_command` roda DENTRO deste contêiner e fala com o bucket: sem,,
infra/compose/docker-compose.prod.yml,267,comment,,"# estas três o archive-push falha em silêncio a cada segmento de WAL, o",,
infra/compose/docker-compose.prod.yml,268,comment,,# Postgres passa a acumular `pg_wal` e o disco acaba. Estavam só no serviço,,
infra/compose/docker-compose.prod.yml,269,comment,,"# de backup, que não é quem arquiva.",,
infra/compose/docker-compose.prod.yml,271,identifier,segredo,PGBACKREST_REPO1_S3_KEY_SECRET: ${BACKUP_S3_SEGREDO},C,D-06/D-36
infra/compose/docker-compose.prod.yml,276,comment,,"# `off` no primeiro `up`, de propósito. Arquivar antes de a stanza existir",,
infra/compose/docker-compose.prod.yml,277,comment,,"# é o mesmo que não arquivar, só que enchendo o disco: o `archive_command`",,
infra/compose/docker-compose.prod.yml,279,comment,,# implantação manda rodar `pgbackrest stanza-create` e SÓ ENTÃO trocar esta,,
infra/compose/docker-compose.prod.yml,280,comment,,# variável para `on` e reiniciar o banco.,,
infra/compose/docker-compose.prod.yml,284,comment,,# WAL fechado a cada 60s: é isto que torna verdadeira a promessa de RPO de 5,,
infra/compose/docker-compose.prod.yml,285,comment,,"# minutos num banco parado de madrugada, quando o WAL demoraria horas a encher.",,
infra/compose/docker-compose.prod.yml,294,comment,,# O papel `pipe_app` NÃO nasce das migrations: todo `grant` para ele em,,
infra/compose/docker-compose.prod.yml,295,comment,,# packages/db/drizzle vem embrulhado em `IF EXISTS (... pg_roles ...)` e é,,
infra/compose/docker-compose.prod.yml,296,comment,,# pulado em silêncio se o papel não existir. Em desenvolvimento quem o cria,,
infra/compose/docker-compose.prod.yml,297,comment,,"# é docker/postgres/init.sql, que este compose nunca montou — e o resultado",,
infra/compose/docker-compose.prod.yml,298,comment,,# era API e fronts sem conseguir conectar com DATABASE_URL_APP.,,
infra/compose/docker-compose.prod.yml,299,comment,,"# O diretório roda uma vez só, na inicialização de um PGDATA vazio, ANTES",,
infra/compose/docker-compose.prod.yml,300,comment,,# do primeiro `migrar` — que é exatamente a ordem que os grants exigem.,,
infra/compose/docker-compose.prod.yml,303,comment,,# O soquete unix é compartilhado com o contêiner de backup: é assim que o,,
infra/compose/docker-compose.prod.yml,304,comment,,# pgBackRest abre e fecha o backup sem que o Postgres precise escutar em TCP,,
infra/compose/docker-compose.prod.yml,305,comment,,# para alguém além da rede `dados`.,,
infra/compose/docker-compose.prod.yml,308,comment,,# ou um túnel SSH — não um mapeamento que fica aberto para sempre.,,
