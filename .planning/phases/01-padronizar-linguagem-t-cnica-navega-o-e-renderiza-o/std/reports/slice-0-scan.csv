infra/compose/postgres/Dockerfile,3,comment,,# O pgbackrest precisa estar NESTE contêiner porque o archive_command do Postgres,,
infra/compose/postgres/Dockerfile,4,comment,,# o executa a cada segmento de WAL. Deixá-lo só no contêiner de backup dá um banco,,
infra/compose/postgres/Dockerfile,5,comment,,# que arquiva WAL para lugar nenhum — e a descoberta vem no dia da restauração.,,
infra/compose/postgres/Dockerfile,12,comment,,# O repositório fica em storage de objetos; o diretório local guarda só o spool,,
infra/compose/postgres/Dockerfile,13,comment,,# do archive-push assíncrono.,,
infra/compose/postgres/init/10-papel-app.sh,1,path,papel,infra/compose/postgres/init/10-papel-app.sh,,
infra/compose/postgres/init/10-papel-app.sh,2,comment,,"# Cria o papel da aplicação. Roda UMA vez, na inicialização de um PGDATA vazio,",,
infra/compose/postgres/init/10-papel-app.sh,5,comment,,# Por que aqui e não numa migration: as migrations de packages/db concedem,,
infra/compose/postgres/init/10-papel-app.sh,6,comment,,# privilégio a `pipe_app` sempre sob `IF EXISTS (SELECT 1 FROM pg_roles ...)`.,,
infra/compose/postgres/init/10-papel-app.sh,7,comment,,"# Se o papel nascer DEPOIS delas, os grants já foram pulados, a migration consta",,
infra/compose/postgres/init/10-papel-app.sh,8,comment,,# como aplicada e ninguém roda de novo — a API conecta e não enxerga tabela,,
infra/compose/postgres/init/10-papel-app.sh,9,comment,,"# nenhuma. Ordem errada aqui é defeito silencioso, e o mais caro de achar.",,
infra/compose/postgres/init/10-papel-app.sh,11,comment,,# O papel não é dono de nada e não tem `bypassrls`: é isso que faz a política,,
infra/compose/postgres/init/10-papel-app.sh,13,comment,,"# Sem `-u`: quando o bit de execução não sobrevive ao clone, o entrypoint do",,
infra/compose/postgres/init/10-papel-app.sh,14,comment,,"# Postgres SOURCEIA este arquivo em vez de executá-lo, e `set -u` passaria a",,
infra/compose/postgres/init/10-papel-app.sh,15,comment,,# valer para o resto do entrypoint. `-e` e a checagem explícita abaixo bastam.,,
infra/compose/postgres/init/10-papel-app.sh,18,identifier,senha,"if [ -z ""${POSTGRES_APP_SENHA:-}"" ]; then",,
infra/compose/postgres/init/10-papel-app.sh,19,identifier,esta,"echo ""FALHA: POSTGRES_APP_SENHA não está definida."" >&2",,
infra/compose/postgres/init/10-papel-app.sh,19,identifier,nao,"echo ""FALHA: POSTGRES_APP_SENHA não está definida."" >&2",,
infra/compose/postgres/init/10-papel-app.sh,19,identifier,senha,"echo ""FALHA: POSTGRES_APP_SENHA não está definida."" >&2",C,D-06/D-36
infra/compose/postgres/init/10-papel-app.sh,20,identifier,com,"echo ""É a senha de pipe_app e precisa bater com a de DATABASE_URL_APP."" >&2",,
infra/compose/postgres/init/10-papel-app.sh,20,identifier,precisa,"echo ""É a senha de pipe_app e precisa bater com a de DATABASE_URL_APP."" >&2",,
infra/compose/postgres/init/10-papel-app.sh,20,identifier,senha,"echo ""É a senha de pipe_app e precisa bater com a de DATABASE_URL_APP."" >&2",,
infra/compose/postgres/init/10-papel-app.sh,24,comment,,"# `:'senha'` é substituição do psql, que escapa o valor como literal — senha com",,
infra/compose/postgres/init/10-papel-app.sh,25,comment,,# aspas ou barra invertida não vira injeção nem erro de sintaxe. Dentro de bloco,,
infra/compose/postgres/init/10-papel-app.sh,26,comment,,"# `do $$ ... $$` a substituição NÃO acontece, por isso o comando é direto.",,
infra/compose/postgres/init/10-papel-app.sh,27,comment,,# O papel não pode existir aqui: este diretório só roda com PGDATA vazio.,,
infra/compose/postgres/init/10-papel-app.sh,28,identifier,username,"psql -v ON_ERROR_STOP=1 --username ""$POSTGRES_USER"" --dbname ""$POSTGRES_DB"" \",,
infra/compose/postgres/init/10-papel-app.sh,29,identifier,senha,"--set senha=""$POSTGRES_APP_SENHA"" <<'SQL'",,
infra/compose/postgres/init/10-papel-app.sh,30,identifier,senha,create role pipe_app login password :'senha';,,
infra/compose/postgres/init/10-papel-app.sh,35,identifier,papel,"echo ""papel pipe_app criado""",,
