infra/k8s/base/web.yaml,53,comment,,# Gestão como SPA estática (Vite + nginx): sem `envFrom` — não fala com o,,
infra/k8s/base/web.yaml,54,comment,,"# Postgres nem com o Redis, e as URLs que precisa (`api`, `desk`) já vêm",,
infra/k8s/base/web.yaml,55,comment,,"# assadas no bundle pela imagem (`apps/gestao-vite/Dockerfile`, build-arg). A",,
infra/k8s/base/web.yaml,56,comment,,"# porta do contêiner é a 80 do nginx, não a 3000 do Next.",,
