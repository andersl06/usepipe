infra/construir-imagens.sh,2,comment,,# Constrói as imagens do Pipe. Roda da raiz do repositório ou de qualquer lugar.,,
infra/construir-imagens.sh,5,comment,,#   ./infra/construir-imagens.sh v1.4.2 api      # só a API,,
infra/construir-imagens.sh,8,comment,,# A versão é obrigatória e vira a tag que o docker-compose.prod.yml consome em,,
infra/construir-imagens.sh,9,comment,,"# `${PIPE_VERSAO}`. `latest` sai junto, e só ela: um deploy nunca deve apontar",,
infra/construir-imagens.sh,10,comment,,"# para `latest`, porque então ""voltar a versão anterior"" deixa de ter sentido.",,
infra/construir-imagens.sh,13,identifier,construir,"VERSAO=""${1:?uso: construir-imagens.sh <versao> [app ...]}""",,
infra/construir-imagens.sh,13,identifier,imagens,"VERSAO=""${1:?uso: construir-imagens.sh <versao> [app ...]}""",,
infra/construir-imagens.sh,13,identifier,versao,"VERSAO=""${1:?uso: construir-imagens.sh <versao> [app ...]}""",,
infra/construir-imagens.sh,14,identifier,shift,shift || true,,
infra/construir-imagens.sh,19,identifier,gestao,[[ ${#APPS[@]} -eq 0 ]] && APPS=(api workers desk-vite gestao-vite crm site),,
infra/construir-imagens.sh,23,comment,,# BuildKit explícito: é ele que honra o `apps/<app>/Dockerfile.dockerignore` e o,,
infra/construir-imagens.sh,24,comment,,"# cache de store do pnpm. No builder clássico a build funciona, só fica lenta e",,
infra/construir-imagens.sh,28,comment,,"# Mesmo com a base já em cache, o BuildKit consulta o registro para resolver o",,
infra/construir-imagens.sh,29,comment,,# manifesto do `node:22-alpine` — e para a build inteira se a rede oscilar.,,
infra/construir-imagens.sh,30,comment,,# `SEM_PULL=1` usa o que já está em cache. Não use em CI: lá interessa a base,,
infra/construir-imagens.sh,31,comment,,"# atualizada, com as correções de segurança do alpine.",,
infra/construir-imagens.sh,33,identifier,sem,"[[ ""${SEM_PULL:-0}"" == ""1"" ]] && PULL=(--pull=false)",,
infra/construir-imagens.sh,35,comment,,# Os links ENTRE os módulos são assados no pacote do navegador durante a build:,,
infra/construir-imagens.sh,36,comment,,"# `NEXT_PUBLIC_*` (Next, em `desk`) e `VITE_*` (Vite, em `gestao-vite`) não são",,
infra/construir-imagens.sh,37,comment,,"# lidas em tempo de execução, e por isso não adianta pô-las no `.env` da VPS.",,
infra/construir-imagens.sh,38,comment,,# Sem estas linhas a imagem sai apontando para `localhost` e o botão que leva do,,
infra/construir-imagens.sh,39,comment,,# Desk à Gestão — ou a Gestão à `api` — não sai do lugar em produção.,,
infra/construir-imagens.sh,41,comment,,"# O padrão é o domínio de produção, e não o de desenvolvimento: quem constrói",,
infra/construir-imagens.sh,42,comment,,"# imagem está publicando. Para uma imagem local, passe as quatro por ambiente.",,
infra/construir-imagens.sh,43,identifier,com,"DOMINIO=""${PIPE_DOMINIO:-usepipe.com.br}""",,
infra/construir-imagens.sh,43,identifier,dominio,"DOMINIO=""${PIPE_DOMINIO:-usepipe.com.br}""",,
infra/construir-imagens.sh,44,identifier,dominio,"URL_DESK=""${PIPE_URL_DESK:-https://app.${DOMINIO}}""",,
infra/construir-imagens.sh,45,identifier,dominio,"URL_GESTAO=""${PIPE_URL_GESTAO:-https://gestao.${DOMINIO}}""",,
infra/construir-imagens.sh,45,identifier,gestao,"URL_GESTAO=""${PIPE_URL_GESTAO:-https://gestao.${DOMINIO}}""",,
infra/construir-imagens.sh,46,identifier,dominio,"URL_CRM=""${PIPE_URL_CRM:-https://crm.${DOMINIO}}""",,
infra/construir-imagens.sh,47,identifier,dominio,"URL_API=""${PIPE_URL_API:-https://api.${DOMINIO}}""",,
infra/construir-imagens.sh,50,comment,,"# O site é estático e mora no próprio diretório, sem workspace pnpm nenhum.",,
infra/construir-imagens.sh,52,identifier,contexto,"contexto=""apps/site""",,
infra/construir-imagens.sh,54,identifier,contexto,"contexto="".""",,
infra/construir-imagens.sh,61,identifier,gestao,gestao-vite),,
infra/construir-imagens.sh,66,identifier,versao,"echo ""==> ${REGISTRO}/${app}:${VERSAO}""",,
infra/construir-imagens.sh,69,identifier,versao,"--tag ""${REGISTRO}/${app}:${VERSAO}"" \",,
infra/construir-imagens.sh,74,identifier,contexto,"""$contexto""",,
infra/construir-imagens.sh,78,identifier,imagem,"echo ""imagem                                          tamanho""",,
infra/construir-imagens.sh,80,identifier,versao,"docker image ls ""${REGISTRO}/${app}:${VERSAO}"" --format '{{.Repository}}:{{.Tag}}|{{.Size}}' \",,
infra/construir-imagens.sh,84,comment,,# Tamanho de disco descomprimido. O que trafega no `docker pull` é bem menor —,,
infra/construir-imagens.sh,85,comment,,"# a camada base do node:22-alpine, que responde por ~240 MB de cada linha acima,",,
infra/construir-imagens.sh,86,comment,,"# é a MESMA em `api`, `workers`, `desk` e `crm`: baixa uma vez e as quatro a",,
infra/construir-imagens.sh,87,comment,,# compartilham. `gestao-vite` e `site` não entram nessa conta — a imagem final,,
infra/construir-imagens.sh,88,comment,,"# dos dois é `nginx:1.27-alpine`, bem menor, porque não sobra Node nenhum depois",,
infra/construir-imagens.sh,90,identifier,gestao,"echo ""(tamanho descomprimido; a camada base node:22-alpine é compartilhada por api/workers/desk/crm — gestao-vite e site",,
infra/construir-imagens.sh,90,identifier,por,"echo ""(tamanho descomprimido; a camada base node:22-alpine é compartilhada por api/workers/desk/crm — gestao-vite e site",,
infra/construir-imagens.sh,90,identifier,sao,"echo ""(tamanho descomprimido; a camada base node:22-alpine é compartilhada por api/workers/desk/crm — gestao-vite e site",,
infra/construir-imagens.sh,94,identifier,versao,"docker push ""${REGISTRO}/${app}:${VERSAO}""",,
infra/k8s/base/api.yaml,1,comment,,# API: o serviço que recebe webhook da Meta e o tráfego do Desk.,,
infra/k8s/base/api.yaml,3,comment,,# É o único que não pode ficar indisponível durante uma publicação: webhook,,
infra/k8s/base/api.yaml,4,comment,,"# perdido é mensagem de cliente perdida, e a Meta reenvia por pouco tempo.",,
infra/k8s/base/api.yaml,18,comment,,# Espalha as réplicas por nó: duas réplicas no mesmo nó caem juntas e o,,
infra/k8s/base/api.yaml,19,comment,,# PodDisruptionBudget não salva ninguém.,,
infra/k8s/base/api.yaml,28,identifier,vem,image: ghcr.io/pipe/api:latest # a tag real vem do overlay,,
infra/k8s/base/api.yaml,31,identifier,metricas,"- { name: metricas, containerPort: 9464 }",,
infra/k8s/base/api.yaml,33,identifier,segredos,- secretRef: { name: pipe-segredos },,
infra/k8s/base/api.yaml,35,comment,,# requests é o que o escalonador usa para caber no nó; limits é o teto,,
infra/k8s/base/api.yaml,36,comment,,"# que impede um vazamento de derrubar o vizinho. Sem requests, o pod é",,
infra/k8s/base/api.yaml,37,comment,,# BestEffort e é o primeiro a morrer sob pressão de memória.,,
infra/k8s/base/api.yaml,41,comment,,# Três sondas com papéis diferentes: startup dá tempo ao Next/Nest sem,,
infra/k8s/base/api.yaml,42,comment,,# afrouxar a liveness; readiness tira do balanceamento sem reiniciar;,,
infra/k8s/base/api.yaml,43,comment,,# liveness reinicia. Usar a mesma para as três é como não ter nenhuma.,,
infra/k8s/base/api.yaml,59,comment,,# Tempo para terminar o que está em voo. O padrão de 30s corta requisição de,,
infra/k8s/base/api.yaml,60,comment,,# webhook no meio quando o nó está carregado.,,
infra/k8s/base/api.yaml,71,identifier,metricas,"- { name: metricas, port: 9464, targetPort: metricas }",,
infra/k8s/base/api.yaml,87,comment,,"# Subir rápido, descer devagar: atendimento tem pico curto, e encolher no meio",,
infra/k8s/base/api.yaml,88,comment,,# do pico é como criar um segundo pico.,,
infra/k8s/base/api.yaml,97,comment,,"# 1, não 2. Com duas réplicas, minAvailable=2 proíbe QUALQUER despejo e trava a",,
infra/k8s/base/api.yaml,98,comment,,# drenagem de nó para sempre — o PDB que protege demais vira o incidente.,,
infra/k8s/base/api.yaml,99,comment,,"# Quando o mínimo do HPA subir para 3, este número sobe para 2.",,
infra/k8s/base/kustomization.yaml,1,comment,,# Base compartilhada. O overlay de cada instalação (a compartilhada e a de cada,,
infra/k8s/base/kustomization.yaml,2,comment,,"# cliente dedicado) só troca imagem, réplicas e hostname.",,
infra/k8s/base/kustomization.yaml,4,comment,,# Kustomize e não Helm para a aplicação: não há terceiros consumindo isto como,,
infra/k8s/base/kustomization.yaml,5,comment,,"# chart, e template dentro de YAML é a fonte de metade dos incidentes de deploy.",,
infra/k8s/base/kustomization.yaml,6,comment,,"# Helm continua sendo usado para o que é de terceiros (Traefik, cert-manager).",,
infra/k8s/base/kustomization.yaml,20,identifier,filas,- PIPE_FILAS=bullmq,C,D-06/D-36
infra/k8s/base/kustomization.yaml,21,identifier,padrao,- PIPE_FUSO_PADRAO=America/Sao_Paulo,C,D-06/D-36
infra/k8s/base/kustomization.yaml,21,identifier,sao,- PIPE_FUSO_PADRAO=America/Sao_Paulo,,
infra/k8s/base/kustomization.yaml,24,comment,,# O Secret `pipe-segredos` NÃO nasce aqui: ele é o arquivo SOPS cifrado que o,,
infra/k8s/base/kustomization.yaml,26,comment,,# kustomize é colocá-lo em texto claro no repositório.,,
infra/k8s/base/kustomization.yaml,28,comment,,# O sufixo de hash do configMapGenerator fica LIGADO (padrão): é ele que faz uma,,
infra/k8s/base/kustomization.yaml,29,comment,,"# mudança de configuração reiniciar os pods. Desligar dá o bug clássico de ""mudei",,
infra/k8s/base/kustomization.yaml,30,comment,,"# a variável e nada aconteceu"".",,
infra/k8s/base/rede.yaml,3,comment,,"# Sem NetworkPolicy, qualquer pod de qualquer namespace alcança o banco e o Redis.",,
infra/k8s/base/rede.yaml,4,comment,,# Namespace NÃO é fronteira de rede por padrão — é o engano mais caro de quem,,
infra/k8s/base/rede.yaml,5,comment,,"# acha que ""namespace por tenant"" já isola alguma coisa.",,
infra/k8s/base/rede.yaml,9,identifier,entrada,name: negar-entrada-por-padrao,,
infra/k8s/base/rede.yaml,9,identifier,padrao,name: negar-entrada-por-padrao,,
infra/k8s/base/rede.yaml,9,identifier,por,name: negar-entrada-por-padrao,,
infra/k8s/base/rede.yaml,17,identifier,metrica,name: permitir-ingress-e-metrica,,
