apps/desk-vite/vite.config.ts,5,comment,,/**,,
apps/desk-vite/vite.config.ts,16,comment,,"/* Na VPS o Desk vive em `/desk`, para compartilhar a sessão da Gestão. */",,
apps/gestao-vite/Dockerfile,1,comment,,"# Imagem do Gestão (Vite + React, SPA estática). Construir a partir da RAIZ do monorepo:",,
apps/gestao-vite/Dockerfile,1,path,gestao,apps/gestao-vite/Dockerfile,,
apps/gestao-vite/Dockerfile,4,comment,,# node:22-alpine só no estágio de build: o `engines` da raiz exige `>=22` e o,,
apps/gestao-vite/Dockerfile,5,comment,,# pnpm recusa instalar fora do intervalo. A imagem final não tem Node nenhum —,,
apps/gestao-vite/Dockerfile,6,comment,,"# é `nginx:1.27-alpine` servindo os arquivos que o `vite build` gerou, o mesmo",,
apps/gestao-vite/Dockerfile,7,comment,,# servidor que `apps/site/Dockerfile` usa para o site estático.,,
apps/gestao-vite/Dockerfile,17,comment,,"# `package.json` antes do código-fonte: enquanto nenhum manifesto mudar, o",,
apps/gestao-vite/Dockerfile,19,comment,,"# aplicativos irmãos, porque `--frozen-lockfile` confere o lockfile contra o",,
apps/gestao-vite/Dockerfile,25,identifier,gestao,COPY apps/gestao-vite/package.json apps/gestao-vite/,,
apps/gestao-vite/Dockerfile,28,identifier,autenticacao,COPY packages/autenticacao/package.json packages/autenticacao/,,
apps/gestao-vite/Dockerfile,36,comment,,# `@pipe/gestao-vite...` = o aplicativo e as dependências dele no workspace. Os,,
apps/gestao-vite/Dockerfile,37,comment,,"# outros front-ends, a API e o Next da Gestão nem chegam a ser baixados.",,
apps/gestao-vite/Dockerfile,40,identifier,gestao,"pnpm install --frozen-lockfile --filter ""@pipe/gestao-vite...""",,
apps/gestao-vite/Dockerfile,42,comment,,# `packages` inteiro em vez de listar contracts/core/ui: o grafo de dependência,,
apps/gestao-vite/Dockerfile,43,comment,,# muda e uma lista aqui envelheceria em silêncio. O peso de verdade — os,,
apps/gestao-vite/Dockerfile,44,comment,,# aplicativos irmãos — segue de fora.,,
apps/gestao-vite/Dockerfile,46,identifier,gestao,COPY apps/gestao-vite apps/gestao-vite,,
apps/gestao-vite/Dockerfile,47,comment,,# As URLs para o Desk e para a `api` são ASSADAS no pacote do navegador: o Vite,,
apps/gestao-vite/Dockerfile,48,comment,,"# só expõe em `import.meta.env` o que existir no ambiente NA HORA do build, e",,
apps/gestao-vite/Dockerfile,49,comment,,# nunca lê variável de execução depois — sem estes dois `ARG` a imagem de,,
apps/gestao-vite/Dockerfile,50,comment,,# produção sai apontando para `localhost` e o front chama a própria origem,,
apps/gestao-vite/Dockerfile,51,comment,,# (que não tem `/v1`) em vez da `api`. Os padrões continuam sendo os de,,
apps/gestao-vite/Dockerfile,52,comment,,"# desenvolvimento, para `docker build` sem argumento continuar servindo.",,
apps/gestao-vite/Dockerfile,57,identifier,gestao,"RUN pnpm --filter ""@pipe/gestao-vite..."" build",,
apps/gestao-vite/Dockerfile,60,comment,,# Só o `dist/`: o `vite build` já deixa em disco exatamente o que o navegador,,
apps/gestao-vite/Dockerfile,64,identifier,gestao,COPY apps/gestao-vite/nginx.conf /etc/nginx/conf.d/default.conf,,
apps/gestao-vite/Dockerfile,65,identifier,gestao,COPY --from=build /app/apps/gestao-vite/dist /usr/share/nginx/html,,
apps/gestao-vite/Dockerfile,70,identifier,cmd,CMD wget -q --spider http://127.0.0.1/ || exit 1,,
apps/gestao-vite/Dockerfile,72,identifier,cmd,"CMD [""nginx"", ""-g"", ""daemon off;""]",,
apps/gestao-vite/Dockerfile.dockerignore,1,path,gestao,apps/gestao-vite/Dockerfile.dockerignore,,
