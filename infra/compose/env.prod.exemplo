# Modelo do que o arquivo SOPS precisa conter. Este exemplo é versionado; o
# arquivo com valor real é `segredos/producao.enc.env`, cifrado, e o .env em
# texto claro só existe em /opt/pipe-dados/.env, na VPS, com modo 600.
#
# O que NÃO entra aqui: token da Meta e segredo de canal do cliente. Esses vivem
# em `canal.config`, cifrados no banco com o chaveiro abaixo — é o que permite
# dois números de WhatsApp no mesmo tenant e rotação por cliente sem redeploy.
#
# A lista de o-que-é-cada-um, onde nasce e como gerar está em
# docs/specs/2026-09-07-implantacao.md, §3. Aqui ficam só os nomes e o formato.
#
# ATENÇÃO: este arquivo é lido de duas formas ao mesmo tempo —
#   1. `--env-file` do compose, que resolve os `${...}` do docker-compose.prod.yml;
#   2. `env_file:` dos serviços, que vira ambiente do processo.
# Por isso nada de aspas, nada de `$` solto e nada de espaço em volta do `=`:
# o compose não roda shell, e `SENHA="a b"` chega com as aspas dentro do valor.

PIPE_VERSAO=v0.0.0
ACME_EMAIL=infra@usepipe.com.br

# --- Banco --------------------------------------------------------------------
# Dois papéis, como no desenvolvimento. O da aplicação não é dono e não tem
# bypassrls — é isso que faz a RLS valer.
#
# As TRÊS linhas precisam concordar: POSTGRES_SENHA é a do papel `pipe` e aparece
# em DATABASE_URL; POSTGRES_APP_SENHA é a do papel `pipe_app`, criado na primeira
# inicialização do banco por postgres/init/10-papel-app.sh, e aparece em
# DATABASE_URL_APP. Senha divergente aqui = API que sobe e não conecta.
POSTGRES_SENHA=
POSTGRES_APP_SENHA=
DATABASE_URL=postgres://pipe:SENHA@postgres:5432/pipe
DATABASE_URL_APP=postgres://pipe_app:SENHA_APP@postgres:5432/pipe
REDIS_URL=redis://redis:6379

# `off` até `pgbackrest --stanza=pipe stanza-create` ter rodado. Ligado antes
# disso, o arquivamento falha a cada segmento e o `pg_wal` enche o disco.
PG_ARCHIVE_MODE=off

# --- Cifra dos segredos de canal ----------------------------------------------
# Chaveiro que cifra `canal.config` — token da Meta, appSecret, senha de SMTP.
# Com o token, qualquer um manda mensagem PELO NÚMERO DO CLIENTE.
#
# Formato: `<id>:<32 bytes em base64>`, vários separados por vírgula. O id fica
# dentro de cada valor cifrado, então rotacionar é acrescentar a chave nova,
# apontar PIPE_CHAVE_SEGREDO_ATUAL para ela e manter a antiga na lista até tudo
# ter sido regravado. 32 bytes exatos: o parser recusa qualquer outro tamanho.
#
# Gerar: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
#
# Sem isto a API SOBE e `/saude` responde 200, mas todo webhook do WhatsApp vira
# 500 — porque a chave só é lida na hora de decifrar o canal. É a falha mais
# cara de diagnosticar da lista, e é por isso que o script de implantação recusa
# subir sem ela.
PIPE_CHAVES_SEGREDO=
PIPE_CHAVE_SEGREDO_ATUAL=k1

# --- Entrar com Google --------------------------------------------------------
# Google Cloud Console → APIs e Serviços → Credenciais → ID do cliente OAuth (web).
# A URL de retorno precisa bater EXATAMENTE com a cadastrada lá.
# Sem estas três, `GET /v1/auth/google` redireciona para `?erro=falha_no_provedor`
# e ninguém entra — nem você.
GOOGLE_CLIENTE_ID=
GOOGLE_CLIENTE_SEGREDO=
GOOGLE_URL_RETORNO=https://api.usepipe.com.br/v1/auth/google/retorno

# --- Sessão, CORS e URLs públicas ---------------------------------------------
# Lista fechada de origens que podem chamar a API com credencial. NUNCA curinga:
# com `credentials: true` o navegador recusa `*`. Vazio = nenhuma tela funciona.
PIPE_ORIGENS=https://app.usepipe.com.br,https://gestao.usepipe.com.br,https://crm.usepipe.com.br
# Domínio-pai do cookie, COM o ponto na frente: é o que faz o cookie emitido por
# `api.` valer em `app.`, `gestao.` e `crm.`.
PIPE_COOKIE_DOMINIO=.usepipe.com.br
PIPE_COOKIE_SEGURO=true
# Onde a volta do login cai quando NÃO se sabe de qual dos três a pessoa veio. O
# caminho normal é o `?origem=` que cada front manda na ida — e esse valor NÃO vem
# daqui: é `PIPE_URL_ESTE_APP`, fixado por serviço no docker-compose.prod.yml,
# justamente porque é a única variável que muda entre Desk, Gestão e CRM.
PIPE_URL_APP=https://app.usepipe.com.br
PIPE_URL_ENTRADA=https://app.usepipe.com.br/entrar
# Base pública da API. Dela sai a URL de retorno do SSO — a MESMA para todos os
# clientes. Mudar depois que um cliente ligou SSO quebra o login dele.
PIPE_URL_API=https://api.usepipe.com.br

# --- API ----------------------------------------------------------------------
PORT=3100
PIPE_LIMITE_CORPO=2mb
PIPE_SAUDE_TIMEOUT_MS=2000
# `/metrics` não está publicado pelo Traefik (o roteador da api nega o prefixo),
# e o Prometheus coleta por dentro, de um IP privado. Vazio serve nesta topologia.
# Preencha quando alguém de fora for coletar — e aí acrescente `authorization` no
# scrape_config de infra/observabilidade/prometheus.yml.
PIPE_METRICS_TOKEN=

# --- Filas e entrega ----------------------------------------------------------
PIPE_FILAS=bullmq
# `real` fala com a Cloud API de verdade. `duble` simula e é o que se usa para
# provar o caminho ponta a ponta antes de existir número aprovado na Meta.
PIPE_WHATSAPP_CLIENTE=real
PIPE_FUSO_PADRAO=America/Sao_Paulo
PIPE_ENTREGA_MAX_TENTATIVAS=5
PIPE_ENTREGA_CONCORRENCIA=4
PIPE_AGREGACAO_CRON=10 3 * * *
# Base pública do storage de objetos: `anexo.chave_storage` é concatenada aqui
# para virar o link que a Meta baixa. Bucket PRIVADO (§4 da spec de infra).
PIPE_STORAGE_URL_BASE=https://arquivos.usepipe.com.br/pipe

# --- WhatsApp: fallback de instalação de um número só --------------------------
# O lugar certo destes valores é `canal.config`, gravado pelo cadastro embutido
# da Meta. Ficam aqui só enquanto houver um número apenas, e o APP_SECRET é
# obrigatório de verdade: a rota guarda-chuva `POST /webhooks/whatsapp`, que
# recebe evento de template e de qualidade de TODOS os clientes, só valida
# assinatura com ele.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_TOKEN_ACESSO=
WHATSAPP_API_VERSAO=v21.0

# --- IA ------------------------------------------------------------------------
ANTHROPIC_API_KEY=
PIPE_IA_MODELO=claude-sonnet-5

# --- Backup --------------------------------------------------------------------
# Chave do bucket e a senha de cifra do repositório pgBackRest. Perder a segunda
# é perder TODOS os backups — ela tem cópia offline, fora deste arquivo.
# As três vão para o contêiner do Postgres (que arquiva WAL) e para o de backup.
BACKUP_S3_KEY=
BACKUP_S3_SEGREDO=
PGBACKREST_REPO1_CIPHER_PASS=

# Interruptores de homem morto (healthchecks.io ou equivalente gratuito). Se a
# VPS inteira morrer, o Prometheus morre junto: quem avisa é o serviço de fora
# que parou de receber o ping.
HEALTHCHECK_URL_BACKUP=
HEALTHCHECK_URL_RESTAURACAO=

GRAFANA_SENHA=
