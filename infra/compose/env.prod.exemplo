# Modelo do que o arquivo SOPS precisa conter. Este exemplo é versionado; o
# arquivo com valor real é `segredos/producao.enc.env`, cifrado, e o .env em
# texto claro só existe em /opt/pipe-dados/.env, na VPS, com modo 600.
#
# O que NÃO entra aqui: token da Meta e segredo de canal do cliente. Esses vivem
# em `canal.config`, cifrados no banco com PIPE_CHAVE_CANAIS — é o que permite
# dois números de WhatsApp no mesmo tenant e rotação por cliente sem redeploy.

PIPE_VERSAO=v0.0.0
PIPE_CRM_VERSAO=v0.0.0
ACME_EMAIL=infra@pipe.com.br

# Banco: dois papéis, como no desenvolvimento. O da aplicação não é dono e não tem
# bypassrls — é isso que faz a RLS valer.
POSTGRES_SENHA=
DATABASE_URL=postgres://pipe:SENHA@postgres:5432/pipe
DATABASE_URL_APP=postgres://pipe_app:SENHA@postgres:5432/pipe
REDIS_URL=redis://redis:6379

# Chave mestra que cifra `canal.config`. Rotacionar significa gerar uma nova,
# manter a antiga para decifrar o histórico e recifrar em segundo plano — por isso
# o campo cifrado carrega o id da chave que o gerou.
PIPE_CHAVE_CANAIS=
PIPE_CHAVE_CANAIS_ID=1

ANTHROPIC_API_KEY=
PIPE_IA_MODELO=claude-sonnet-5

PIPE_FILAS=bullmq
PIPE_WHATSAPP_CLIENTE=real
PIPE_FUSO_PADRAO=America/Sao_Paulo
PIPE_STORAGE_URL_BASE=https://arquivos.pipe.com.br/pipe

# Backup: chave do bucket e a senha de cifra do repositório pgBackRest. Perder a
# segunda é perder todos os backups — ela tem cópia offline, fora deste arquivo.
BACKUP_S3_KEY=
BACKUP_S3_SEGREDO=
PGBACKREST_REPO1_CIPHER_PASS=

# Interruptores de homem morto (healthchecks.io ou equivalente gratuito).
HEALTHCHECK_URL_BACKUP=
HEALTHCHECK_URL_RESTAURACAO=

GRAFANA_SENHA=
